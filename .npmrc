# Read by npm only; this repository installs with pnpm, which ignores it.
#
# Base44's managed preview and its Publish build install dependencies with
# npm. On the Node 24 runtime Base44 now uses (measured 2026-10-09: Node
# 24.21.0, npm 10.9.9), npm crashes while resolving this tree's peer
# dependencies -- "Cannot read properties of null (reading 'edgesOut')" -- so
# the preview never starts. The same tree resolves with Node 20 and npm
# 10.8.2. Skipping npm's automatic peer installation avoids the crash. What
# that changes, measured against the strict resolution: @testing-library/dom
# and the test-only packages it pulls in are not installed, and the hoisted
# react-is is 16.13.1 rather than 19.3.0, which recharts' peer range
# (^16.8.0 || ... || ^19.0.0) accepts. ci.yml checks both runtimes, with peers
# enforced on the older one.
legacy-peer-deps=true

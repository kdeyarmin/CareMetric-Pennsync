    "distributePolicyAcknowledgment": {
      "entities": [
        "TrainingAuditLog"
      ],
      "served_by": "pennsync_records.activity_audit (D25)",
      "because": "The capability is PolicyLibrary to PolicyAcknowledgment and Notification, all three carried. Its TrainingAuditLog row is one fire-and-forget summary written after the loop, whose failure the module already logs and ignores, and whose contents - actor, policy version, distributed and failed counts - are the shape D25's activity trail takes. Fourteen of the fifteen modules that write that table are hub; this is the only port one, which is what makes the row an orphan leg of a policy capability rather than a learning capability."
    },
    "generateAIReport": {
      "entities": [
        "TrainingAssignment"
      ],
      "served_by": "the Support Hub's own learning reports (D8)",
      "because": "One of nine parallel datasets, feeding two figures - training_completed and avg_training_score - into one block of one PDF. The other eight are carried clinical and compliance entities. D8 says learner history is preserved by the Hub cutover rather than this one, and exportLearningReportCSV and getTeamTrainingReadiness already live there, so the leg has a destination rather than being dropped."
    },
    "offboardUser": {
      "entities": [
        "PhoneNumber",
        "ScheduledFax",
        "ScheduledSignatureReminder",
        "ScheduledSms",
        "UserActivity"
      ],
      "served_by": "pennsync_records.activity_audit (D25); the paused comms domain (D7)",
      "because": "The core is carried PHI revocation - deactivate, revoke memberships, unassign charts, clear on-call, cancel invitations - and every uncarried leg is a separate try-caught block appended after it. The three schedule cancels exist to defuse dispatchers that D7 carries paused, so in this system there is nothing pending to cancel; the module's own comment says the cancels exist because dispatchScheduledSms would still fire, and it does not run. The UserActivity row is D25's case exactly, and it is load-bearing rather than incidental - the module says an auditor treats its counts as proof that PHI access was withdrawn - so it is repointed at the trail as part of the port, never dropped."
    },
    "sendExpirationNotifications": {
      "entities": [
        "TrainingAssignment"
      ],
      "served_by": "sendTrainingNotifications on the Support Hub (D9)",
      "because": "D9 already settled this one by name: the credential half ports and the training half drops out to the Hub, where sendTrainingNotifications already lives. The module is two independent symmetric loops over TrainingAssignment and PersonnelCredential feeding one admin fan-out, so the credential half stands alone with the same expiry tiers, the same claim-token idempotency and the same agency scoping."
    }
  }
}

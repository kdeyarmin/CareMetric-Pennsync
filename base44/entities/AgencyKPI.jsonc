{
  "name": "AgencyKPI",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Reference to Agency if multi-agency"
    },
    "is_current": {
      "type": "boolean",
      "description": "Whether this row is the current result for its agency, measure, and period. Outcome dashboards read only true; a no-denominator rerun marks a prior row false without deleting its audit history."
    },
    "retired_reason": {
      "type": "string",
      "description": "Why a previously current outcome KPI was made non-current."
    },
    "retired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a previously current outcome KPI was made non-current."
    },
    "metric_name": {
      "type": "string",
      "description": "Name of KPI metric"
    },
    "metric_category": {
      "type": "string",
      "enum": [
        "financial",
        "clinical",
        "operational",
        "compliance",
        "quality"
      ],
      "description": "Category of metric"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "yearly",
        "custom"
      ],
      "description": "Explicit reporting-window classification; use custom when the supplied dates do not match a standard calendar period"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "metric_value": {
      "type": "number",
      "description": "Actual metric value"
    },
    "target_value": {
      "type": "number",
      "description": "Target/goal value"
    },
    "benchmark_value": {
      "type": "number",
      "description": "Industry benchmark"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (%, $, count, etc.)"
    },
    "trend": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "description": "Trend direction"
    },
    "variance_percentage": {
      "type": "number",
      "description": "Variance from target (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "on_target",
        "warning",
        "critical"
      ],
      "description": "Performance status"
    },
    "input_response_schema_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Response schema ids contributing to this internal KPI. A KPI without verified v2 provenance stays auditable but is excluded from current proxy views."
    },
    "calculation_version": {
      "type": "string",
      "description": "Version of the deterministic outcome core that produced this KPI."
    },
    "excluded_episode_count": {
      "type": "number",
      "description": "Episodes excluded from this KPI's denominator, so a rate is never read as covering everyone."
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvement_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "metric_name",
    "metric_category",
    "period_start",
    "period_end",
    "metric_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}

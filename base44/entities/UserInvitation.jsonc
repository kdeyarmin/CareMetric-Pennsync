{
  "name": "UserInvitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of invited user"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of invited user"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "care_scope": {
      "type": "string",
      "enum": [
        "home_health",
        "hospice",
        "both"
      ],
      "default": "home_health"
    },
    "phone": {
      "type": "string"
    },
    "credentials": {
      "type": "string"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of admin who sent invitation"
    },
    "agency_name": {
      "type": "string",
      "description": "Agency of the inviting admin; used to scope agency_admin resend/cancel"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When invitation expires (7 days from creation)"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When invitation was last sent/resent"
    },
    "expiring_soon_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When admins were emailed that this pending invitation expires within 24 hours (one-shot per invitation)"
    },
    "resend_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times invitation was resent"
    }
  },
  "required": [
    "email",
    "full_name",
    "invited_by",
    "expires_at"
  ],
  "//write-note": "Writes are service-role-only: an admin who could create a UserInvitation directly could forge { role: 'admin' } and have onUserSignup apply it verbatim, bypassing the 'only a super admin may invite an admin' guard. All legitimate invitation writes go through userManagement / createUserWithTempPassword (service role). Admins still READ invitations for the management UI.",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
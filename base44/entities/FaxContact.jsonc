{
  "name": "FaxContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "fax_number": {
      "type": "string",
      "description": "Fax number with country code"
    },
    "company": {
      "type": "string",
      "description": "Company or organization name"
    },
    "organization": {
      "type": "string",
      "description": "Organization name (written/read by Fax address book UI)"
    },
    "department": {
      "type": "string",
      "description": "Department name"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this contact"
    },
    "user_email": {
      "type": "string",
      "description": "Owner of this contact"
    },
    "agency_id": {
      "type": "string",
      "description": "Agency ID for shared contacts in enterprise mode"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Whether this contact is shared with the agency"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a favorite contact"
    }
  },
  "required": [
    "name",
    "fax_number",
    "user_email"
  ],
  // Agency-shared contacts remain unavailable until tenant membership is
  // server-owned. For now every browser operation is pinned to the authenticated
  // owner's email; Base44 evaluates this rule on each candidate record.
  "rls": {
    "read": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_email": "{{user.email}}" }
      ]
    },
    "create": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_email": "{{user.email}}" }
      ]
    },
    "update": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_email": "{{user.email}}" }
      ]
    },
    "delete": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_email": "{{user.email}}" }
      ]
    }
  }
}

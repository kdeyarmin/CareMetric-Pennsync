{
  "name": "DocumentPackageToken",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Immutable tenant copied from the exact authority-bound package."
    },
    "package_id": {
      "type": "string",
      "description": "Reference to DocumentPackage"
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of DocumentSignature ids in the package at token mint time. validateSignerToken/submitSignerSignature intersect this with live package membership so adding docs after mint cannot expand the PHI the signing link can read or sign. Legacy tokens without a snapshot fall back to live membership only."
    },
    "token": {
      "type": "string",
      "description": "SHA-256 digest of the high-entropy bearer token. Plaintext exists only in the outbound email operation and request memory."
    },
    "token_hashed": {
      "type": "boolean",
      "description": "True when the token field stores a SHA-256 hash (not plaintext). Validators refuse the legacy-plaintext fallback for hashed rows so a leaked stored hash can't be replayed as a bearer token."
    },
    "signer_email": {
      "type": "string",
      "description": "Email of authorized signer"
    },
    "signer_id": {
      "type": "string",
      "description": "Opaque signer id bound to the token; client-supplied identity is never authoritative."
    },
    "status": {
      "type": "string",
      "enum": ["delivery_pending", "delivery_indeterminate", "delivery_rejected", "active", "claimed", "consumed", "revoked", "expired"],
      "default": "active"
    },
    "authority_version": {
      "type": "number",
      "default": 1,
      "description": "Monotonic revision used for conditional token claims, releases, and terminal transitions."
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Immutable User id that authorized minting, or the original package creator for scheduler rotation."
    },
    "creator_membership_id": {
      "type": "string"
    },
    "creator_membership_version": {
      "type": "number"
    },
    "token_request_id": {
      "type": "string",
      "description": "Opaque server-side issuance request id used for duplicate detection."
    },
    "delivery_attempt_id": { "type": "string" },
    "delivery_state": {
      "type": "string",
      "enum": ["pending", "accepted", "indeterminate", "rejected"]
    },
    "delivery_settled_at": { "type": "string", "format": "date-time" },
    "signer_name": {
      "type": "string",
      "description": "Name of signer for personalization"
    },
    "token_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When token was generated"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiration timestamp"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether token is still valid"
    },
    "access_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times token was used to access"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time token was used"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_by_request_id": {
      "type": "string"
    },
    "claimed_by_operation_id": {
      "type": "string",
      "description": "Server-generated owner of the in-flight conditional claim; caller retry ids never confer claim ownership."
    },
    "claimed_document_id": {
      "type": "string",
      "description": "Exact DocumentSignature protected by the in-flight claim."
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_completed_request_id": {
      "type": "string",
      "description": "Most recent signature submission request completed with this token; supports exact response-loss recovery without replaying the legal act."
    },
    "last_completed_document_id": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IP addresses used to access with this token"
    },
    "user_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User agents used to access with this token"
    }
  },
  "required": [
    "package_id",
    "token",
    "signer_email",
    "expires_at"
  ],
  // Signing capabilities are bearer secrets and the entire signing workflow
  // is quarantined. Direct reads and mutations are denied for every user role.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

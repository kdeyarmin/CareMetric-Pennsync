{
  "name": "ProviderFollowUpToken",
  "type": "object",
  // Capability token for the public provider follow-up response portal
  // (src/pages/ProviderFollowUpPortal.jsx, routed pre-auth like SignerPortal).
  // Mirrors DocumentPackageToken: generated by the admin-gated
  // generateFollowUpPortalToken function, consumed by the public
  // validateFollowUpToken / submitFollowUpResponse functions via service role.
  "properties": {
    "referral_id": {
      "type": "string",
      "description": "Referral this token grants response access to"
    },
    "token": {
      "type": "string",
      "description": "SHA-256 hex hash of the secure random bearer token (the plaintext lives only in the portal link handed to the provider; validators hash the presented token before lookup)"
    },
    "provider_name": {
      "type": "string",
      "description": "Referring provider/practice the request was sent to (display only)"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO datetime after which the token is rejected"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Deactivated after submission (single-use) or on expiry"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "expired",
        "revoked"
      ],
      "default": "sent",
      "description": "Canonical provider follow-up delivery/access state used for delivery tracking and dead-letter reporting"
    },
    "access_count": {
      "type": "number",
      "default": 0,
      "description": "Number of successful validations (abuse audit trail)"
    },
    "last_accessed_at": {
      "type": "string",
      "description": "ISO datetime of the most recent validation"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO datetime the provider submitted responses (set once)"
    },
    "submit_claimed_by": {
      "type": "string",
      "description": "Claim token for concurrent submitFollowUpResponse; set before merging answers onto the Referral so two parallel submits cannot both write"
    }
  },
  "required": ["referral_id", "token", "expires_at"],
  // Tokens are bearer secrets: no end-user needs to read them through RLS (the
  // portal functions use service role), so reads are admin-only and writes are
  // service-role only.
  "rls": {
    "read": {
      "user_condition": { "role": "admin" }
    },
    "write": {
      "user_condition": { "role": "__service_role_only__" }
    }
  }
}

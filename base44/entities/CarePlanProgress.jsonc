{
  "name": "CarePlanProgress",
  "type": "object",
  "properties": {
    "care_plan_id": {
      "type": "string",
      "description": "Reference to CarePlan"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient"
    },
    "progress_date": {
      "type": "string",
      "format": "date",
      "description": "Date of progress assessment"
    },
    "documented_by": {
      "type": "string",
      "description": "Provider email who documented progress"
    },
    "provider_type": {
      "type": "string",
      "description": "Type of provider documenting (RN, PT, etc.)"
    },
    "measurement_value": {
      "type": "string",
      "description": "Current measurement or observation"
    },
    "progress_status": {
      "type": "string",
      "enum": [
        "on_track",
        "improving",
        "no_change",
        "declining",
        "goal_met"
      ],
      "description": "Current progress status"
    },
    "notes": {
      "type": "string",
      "description": "Progress notes and observations"
    },
    "barriers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identified barriers to progress"
    },
    "interventions_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which interventions were completed"
    },
    "next_steps": {
      "type": "string",
      "description": "Recommended next steps"
    }
  },
  "required": [
    "care_plan_id",
    "patient_id",
    "progress_date",
    "documented_by",
    "progress_status"
  ]
}
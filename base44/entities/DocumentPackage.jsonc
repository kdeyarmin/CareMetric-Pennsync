{
  "name": "DocumentPackage",
  "type": "object",
  "properties": {
    "package_name": {
      "type": "string",
      "description": "Name of the document package (e.g., Admission Onboarding)"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "document_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of DocumentSignature IDs in this package"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "declined"
      ],
      "default": "pending",
      "description": "Overall package status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When package should be completed"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When all documents were signed"
    },
    "sent_to_patient_at": {
      "type": "string",
      "format": "date-time",
      "description": "When package was sent to patient"
    },
    "auto_reminder_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether automated email reminders should be sent"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 3,
      "description": "Days before due date to send reminder"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy: when any reminder was last sent (prefer audience-specific fields)"
    },
    "last_signer_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last signer-audience package reminder was sent"
    },
    "last_caregiver_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last caregiver-audience package reminder was sent"
    },
    "reminder_claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping reminder crons do not double-send"
    },
    "reminder_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder_claimed_by was written"
    },
    "signer_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Idempotency marker: when notifySignerOfPackage emailed the signer their portal link (one initial notification per package)"
    },
    "signer_notify_claimed_by": {
      "type": "string",
      "description": "Best-effort claim token for notifySignerOfPackage; re-read before minting signer token / emailing"
    },
    "signer_email": {
      "type": "string",
      "description": "Primary signer email for reminder notifications"
    },
    "signer_name": {
      "type": "string",
      "description": "Signer name for personalized reminders"
    }
  },
  "required": [
    "package_name",
    "patient_id",
    "document_signatures"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        }
      ]
    }
  }
}

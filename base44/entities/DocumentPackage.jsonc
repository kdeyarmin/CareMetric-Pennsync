{
  "name": "DocumentPackage",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Immutable tenant id stamped by the server-side signature-request broker."
    },
    "package_key": {
      "type": "string",
      "description": "Server-built SHA-256 idempotency key for the agency, creator, and client request."
    },
    "client_request_id": {
      "type": "string",
      "description": "Bounded caller retry id scoped server-side before use."
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Immutable built-in User id of the request creator."
    },
    "created_by_user_email_normalized": {
      "type": "string",
      "format": "email",
      "description": "Normalized built-in creator email retained as an integrity check."
    },
    "creator_membership_id": {
      "type": "string"
    },
    "creator_membership_version": {
      "type": "number"
    },
    "authority_version": {
      "type": "number",
      "default": 1,
      "description": "Monotonic server-owned revision for conditional package transitions."
    },
    "token_issue_claimed_by": {
      "type": "string",
      "description": "Server-generated owner of the short signer-token issuance lease."
    },
    "token_issue_claimed_at": { "type": "string", "format": "date-time" },
    "token_issue_request_id": { "type": "string" },
    "package_name": {
      "type": "string",
      "description": "Name of the document package (e.g., Admission Onboarding)"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "document_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of DocumentSignature IDs in this package"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "declined"
      ],
      "default": "pending",
      "description": "Overall package status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When package should be completed"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When all documents were signed"
    },
    "sent_to_patient_at": {
      "type": "string",
      "format": "date-time",
      "description": "When package was sent to patient"
    },
    "auto_reminder_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether automated email reminders should be sent"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 3,
      "description": "Days before due date to send reminder"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy: when any reminder was last sent (prefer audience-specific fields)"
    },
    "last_signer_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last signer-audience package reminder was sent"
    },
    "last_caregiver_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last caregiver-audience package reminder was sent"
    },
    "reminder_claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping reminder crons do not double-send"
    },
    "reminder_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder_claimed_by was written"
    },
    "signer_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Idempotency marker: when notifySignerOfPackage emailed the signer their portal link (one initial notification per package)"
    },
    "signer_notify_claimed_by": {
      "type": "string",
      "description": "Best-effort claim token for notifySignerOfPackage; re-read before minting signer token / emailing"
    },
    "signer_email": {
      "type": "string",
      "format": "email",
      "description": "Primary signer email for reminder notifications"
    },
    "signer_id": {
      "type": "string",
      "description": "Opaque signer id shared with the member DocumentSignature signer rows."
    },
    "signer_name": {
      "type": "string",
      "description": "Signer name for personalized reminders"
    }
  },
  "required": [
    "package_name",
    "patient_id",
    "document_signatures"
  ],
  // Package creation and signing are quarantined. Service-role maintenance can
  // still preserve or retire historical rows, but direct access is denied.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

{
  "name": "Visit",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "visit_time": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "skilled_nursing",
        "admission",
        "recertification",
        "discharge",
        "routine_visit",
        "prn"
      ],
      "description": "Type of visit"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "pending_review",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Visit status. 'pending_review' = an offline-captured note whose AI grounding pass is deferred until reconnect (see grounding_pending)."
    },
    "start_time": {
      "type": "string",
      "description": "Actual start time of visit"
    },
    "end_time": {
      "type": "string",
      "description": "Actual end time of visit"
    },
    "nurse_notes": {
      "type": "string",
      "description": "AI-generated Medicare-compliant narrative"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the dictated audio file"
    },
    "raw_transcription": {
      "type": "string",
      "description": "Raw transcription before AI formatting"
    },
    "vital_signs": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "blood_pressure_systolic": {
          "type": "number"
        },
        "blood_pressure_diastolic": {
          "type": "number"
        },
        "heart_rate": {
          "type": "number"
        },
        "respiratory_rate": {
          "type": "number"
        },
        "oxygen_saturation": {
          "type": "number"
        },
        "pain_level": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        }
      }
    },
    "family_update_sent": {
      "type": "boolean",
      "description": "Whether family update was sent",
      "default": false
    },
    "family_update_date": {
      "type": "string",
      "format": "date-time",
      "description": "When family update was sent"
    },
    "family_update_text": {
      "type": "string",
      "description": "Text of family update that was sent"
    },
    "ai_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-generated tags for searchability and trend analysis"
    },
    "telehealth_room_id": {
      "type": "string",
      "description": "Twilio room ID for telehealth visits"
    },
    "telehealth_room_name": {
      "type": "string",
      "description": "Twilio room name"
    },
    "telehealth_call_duration": {
      "type": "number",
      "description": "Call duration in seconds"
    },
    "telehealth_summary": {
      "type": "string",
      "description": "Post-call summary"
    },
    "telehealth_shared_files": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Files shared during telehealth call"
    },
    "telehealth_recording_url": {
      "type": "string",
      "description": "URL to call recording if enabled"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    },
    "client_request_id": {
      "type": "string",
      "description": "Offline idempotency key (queue id) used to dedupe visits created from the offline sync queue"
    },
    "compliance_score": {
      "type": "number",
      "description": "0-100 documentation coverage/compliance score computed from the visit note"
    },
    "compliance_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of compliance issue descriptions derived from chart findings"
    },
    "homebound_status_verified": {
      "type": "boolean",
      "description": "Whether homebound status was documented/verified in the visit note"
    },
    "skilled_intervention_documented": {
      "type": "boolean",
      "description": "Whether a skilled intervention/need was documented in the visit note"
    },
    "homebound_justification": {
      "type": "string",
      "description": "Evidence text justifying the patient's homebound status"
    },
    "documentation_source": {
      "type": "string",
      "enum": [
        "smart_note",
        "audio",
        "manual"
      ],
      "default": "smart_note",
      "description": "How this visit note was captured: 'smart_note' (typed/dictated in the Smart Note Assistant), 'audio' (transcribed from a recording, then grounded against the transcript), or 'manual'. Provenance for the compliance audit trail."
    },
    "grounding_pending": {
      "type": "boolean",
      "default": false,
      "description": "True when the note was saved offline and the AI grounding (fact-check) pass was deferred until reconnect. The deterministic value-guard still ran, but live grounding had not — so the record carries this audit-trail signal until a later online re-save clears it. Surfaced as a pending-verification state in compliance reporting."
    },
    "ai_process_claimed_by": {
      "type": "string",
      "description": "Claim token for processCompletedVisit idempotency. Set before LLM work and re-read before writing the narrative so concurrent double-submits cannot both overwrite nurse_notes."
    },
    "ai_processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When processCompletedVisit finished AI narrative/task generation for this visit"
    },
    "supply_usage_claimed_by": {
      "type": "string",
      "description": "Claim token for analyzeVisitForSupplyUsage idempotency. Set before LLM extraction and inventory writes so concurrent runs cannot double-decrement SupplyItem stock or create duplicate SupplyUsageLog rows."
    },
    "events_extract_claimed_by": {
      "type": "string",
      "description": "Claim token for extractClinicalEvents idempotency. Set before LLM extraction and ClinicalEvent/Task/PatientAlert writes so concurrent runs cannot create duplicate clinical events from the same visit note."
    },
    "events_extracted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When extractClinicalEvents finished creating ClinicalEvent rows for this visit"
    },
    "emr_handoff_status": {
      "type": "string",
      "enum": [
        "not_started",
        "copied_to_emr",
        "reviewed_in_emr",
        "signed_in_emr"
      ],
      "default": "not_started",
      "description": "SELF-REPORTED operational workflow state for moving PennSync's prepared documentation into the agency's EMR. PennSync has no EMR integration: this records only what the nurse said they did and is NEVER evidence that the note was entered, reviewed, or signed in the EMR. The official record remains the EMR."
    },
    "emr_handoff_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Append-only trail of emr_handoff_status reports: { status, reported_by, reported_at, self_reported, note }. Forward-only — a later state is never rewritten by re-reporting an earlier one."
    },
    "documentation_review_ack": {
      "type": "object",
      "description": "AI-governance record that a human reviewed the AI-assisted text before copying it to the EMR: { acknowledged, acknowledged_by, acknowledged_at, note_hash, note_length, ai_assisted, nurse_edited, statement, is_clinical_signature:false }. Explicitly NOT a clinical signature or legal attestation — it stores a note HASH, not a second copy of the note."
    },
    "followup_tasks_claimed_by": {
      "type": "string",
      "description": "Claim token for generateFollowUpTasks idempotency. Set before LLM extraction and Task.create so concurrent runs cannot create duplicate follow-up tasks for the same visit."
    }
  },
  "required": [
    "patient_id",
    "visit_date",
    "visit_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Visit",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "visit_time": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "skilled_nursing",
        "admission",
        "recertification",
        "discharge",
        "routine_visit",
        "prn"
      ],
      "description": "Type of visit"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "start_time": {
      "type": "string",
      "description": "Actual start time of visit"
    },
    "end_time": {
      "type": "string",
      "description": "Actual end time of visit"
    },
    "nurse_notes": {
      "type": "string",
      "description": "AI-generated Medicare-compliant narrative"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the dictated audio file"
    },
    "raw_transcription": {
      "type": "string",
      "description": "Raw transcription before AI formatting"
    },
    "vital_signs": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "blood_pressure_systolic": {
          "type": "number"
        },
        "blood_pressure_diastolic": {
          "type": "number"
        },
        "heart_rate": {
          "type": "number"
        },
        "respiratory_rate": {
          "type": "number"
        },
        "oxygen_saturation": {
          "type": "number"
        },
        "pain_level": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        }
      }
    },
    "family_update_sent": {
      "type": "boolean",
      "description": "Whether family update was sent",
      "default": false
    },
    "family_update_date": {
      "type": "string",
      "format": "date-time",
      "description": "When family update was sent"
    },
    "family_update_text": {
      "type": "string",
      "description": "Text of family update that was sent"
    },
    "ai_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-generated tags for searchability and trend analysis"
    },
    "telehealth_room_id": {
      "type": "string",
      "description": "Twilio room ID for telehealth visits"
    },
    "telehealth_room_name": {
      "type": "string",
      "description": "Twilio room name"
    },
    "telehealth_call_duration": {
      "type": "number",
      "description": "Call duration in seconds"
    },
    "telehealth_summary": {
      "type": "string",
      "description": "Post-call summary"
    },
    "telehealth_shared_files": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Files shared during telehealth call"
    },
    "telehealth_recording_url": {
      "type": "string",
      "description": "URL to call recording if enabled"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    }
  },
  "required": [
    "patient_id",
    "visit_date",
    "visit_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
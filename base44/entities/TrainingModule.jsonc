{
  "name": "TrainingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Training module title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the training"
    },
    "category": {
      "type": "string",
      "enum": [
        "clinical",
        "documentation",
        "compliance",
        "safety",
        "technology",
        "specialty",
        "onboarding"
      ],
      "description": "Training category"
    },
    "module_type": {
      "type": "string",
      "enum": [
        "onboarding",
        "ongoing",
        "skill_development",
        "recertification"
      ],
      "default": "ongoing",
      "description": "Type of training module"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "video",
        "interactive",
        "quiz",
        "document",
        "mixed"
      ],
      "default": "text",
      "description": "Format of the learning content"
    },
    "content": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "video_url": {
          "type": "string"
        },
        "document_url": {
          "type": "string"
        },
        "interactive_elements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "quiz_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "correct_answer": {
                "type": "number"
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Module content in various formats"
    },
    "related_diagnoses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diagnoses this training is relevant for"
    },
    "related_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills developed by this training"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of modules that must be completed first"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Estimated completion time in minutes"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "Difficulty level"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is mandatory agency training"
    },
    "required_for_onboarding": {
      "type": "boolean",
      "default": false,
      "description": "Must be completed during onboarding"
    },
    "recertification_months": {
      "type": "number",
      "description": "Months until recertification required"
    },
    "passing_score": {
      "type": "number",
      "default": 80,
      "description": "Minimum score to pass (percentage)"
    },
    "content_url": {
      "type": "string",
      "description": "External URL to training content"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "description": "Display order within category"
    }
  },
  "required": [
    "title",
    "category",
    "module_type"
  ]
}
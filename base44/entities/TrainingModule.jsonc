{
  "name": "TrainingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Training module title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the training"
    },
    "category": {
      "type": "string",
      "enum": [
        "clinical",
        "documentation",
        "compliance",
        "safety",
        "technology",
        "specialty",
        "onboarding"
      ],
      "description": "Training category"
    },
    "module_type": {
      "type": "string",
      "enum": [
        "onboarding",
        "ongoing",
        "skill_development",
        "recertification"
      ],
      "default": "ongoing",
      "description": "Type of training module"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "video",
        "interactive",
        "quiz",
        "document",
        "mixed"
      ],
      "default": "text",
      "description": "Format of the learning content"
    },
    "content": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "video_url": {
          "type": "string"
        },
        "document_url": {
          "type": "string"
        },
        "interactive_elements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "quiz_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "correct_answer": {
                "type": "number"
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Module content in various formats"
    },
    "related_diagnoses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diagnoses this training is relevant for"
    },
    "related_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills developed by this training"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of modules that must be completed first"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Estimated completion time in minutes"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "Difficulty level"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is mandatory agency training"
    },
    "required_for_onboarding": {
      "type": "boolean",
      "default": false,
      "description": "Must be completed during onboarding"
    },
    "recertification_months": {
      "type": "number",
      "description": "Months until recertification required"
    },
    "passing_score": {
      "type": "number",
      "default": 80,
      "description": "Minimum score to pass (percentage)"
    },
    "content_url": {
      "type": "string",
      "description": "External URL to training content"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "description": "Display order within category"
    },
    "course_id": {
      "type": "string",
      "description": "ID of the parent course this module belongs to (readers filter modules by course_id)"
    },
    "type": {
      "type": "string",
      "description": "Module type as written by generators/seeders (e.g. 'lesson', 'video'); distinct from module_type/content_type and read by TrainingModuleViewer"
    },
    "content_json": {
      "type": "object",
      "description": "Structured module content as written by generators/seeders; read by TrainingModuleViewer"
    },
    "order_index": {
      "type": "number",
      "description": "Zero-based ordering index within a course; used as the filter sort key by TrainingCoursePlayer/OnboardingTracker"
    },
    "estimated_minutes": {
      "type": "number",
      "description": "Estimated completion time in minutes as written by generators; read across training dashboards"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of files attached to this module"
    },
    "attachment_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of attached files"
    },
    "video_url": {
      "type": "string",
      "description": "Top-level generated video URL for the module"
    },
    "video_thumbnail_url": {
      "type": "string",
      "description": "Thumbnail URL for the generated video"
    },
    "video_duration_seconds": {
      "type": "number",
      "description": "Duration of the generated video in seconds"
    },
    "video_status": {
      "type": "string",
      "description": "Status of video generation (e.g. processing, completed, failed)"
    },
    "video_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the video was generated (ISO timestamp)"
    },
    "video_error": {
      "type": "string",
      "description": "Error message from video generation, if any"
    },
    "video_job_id": {
      "type": "string",
      "description": "ID of the external video generation job"
    },
    "video_avatar_id": {
      "type": "string",
      "description": "Avatar ID used for video generation"
    },
    "video_voice_id": {
      "type": "string",
      "description": "Voice ID used for video generation"
    }
  },
  "required": [
    "title",
    "category",
    "module_type"
  ]
}
{
  "name": "PatientMessage",
  "type": "object",
  "description": "Retired parallel patient-message model. Existing rows are quarantined and inaccessible. Any future patient-facing channel requires verified tenant, patient, consent, identity, thread, and participant provenance stamped by a dedicated server broker.",
  "properties": {
    "provenance_version": {
      "type": "integer",
      "enum": [2]
    },
    "provenance_status": {
      "type": "string",
      "enum": ["verified_v2", "quarantined_legacy"]
    },
    "agency_id": {
      "type": "string",
      "description": "Immutable Agency id copied from the exact authorized Patient."
    },
    "sender_user_id": {
      "type": "string",
      "description": "Server-derived built-in sender User id for provider-originated messages."
    },
    "sender_membership_id": {
      "type": "string"
    },
    "sender_membership_version": {
      "type": "integer",
      "minimum": 1
    },
    "participant_user_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "participant_membership_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "membership_id": { "type": "string" },
          "membership_version": { "type": "integer", "minimum": 1 }
        },
        "required": ["user_id", "membership_id", "membership_version"]
      }
    },
    "participant_set_sha256": {
      "type": "string"
    },
    "client_request_id": {
      "type": "string"
    },
    "message_creation_key": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "string"
    },
    "read_by_user_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "conversation_id": {
      "type": "string",
      "description": "Groups messages in same conversation thread"
    },
    "channel": {
      "type": "string",
      "enum": [
        "team",
        "patient"
      ],
      "description": "team = internal care team, patient = patient/caregiver facing"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "provider",
        "patient",
        "caregiver"
      ],
      "description": "Who sent this message"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "body": {
      "type": "string",
      "description": "Message content"
    },
    "subject": {
      "type": "string",
      "description": "Thread subject (set on first message)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Message priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "responded",
        "closed"
      ],
      "default": "unread",
      "description": "Message status"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of emails who have read this message"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether message is pinned in thread"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          }
        }
      },
      "description": "Attached files"
    }
  },
  "required": [
    "patient_id",
    "channel",
    "sender_type",
    "sender_email",
    "body"
  ],
  // This retired parallel message model has no live client callers. Keep it
  // service-role-only until participant and tenant ownership are server-stamped.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

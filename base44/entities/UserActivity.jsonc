{
  "name": "UserActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who performed the action"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user"
    },
    "action": {
      "type": "string",
      "description": "Type of action performed"
    },
    "details": {
      "type": "object",
      "description": "Additional details about the action"
    },
    "page": {
      "type": "string",
      "description": "Page where action occurred"
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity affected (if any)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of entity affected (if any)"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Outcome of the action (e.g. 'success')"
    },
    "device_type": {
      "type": "string",
      "description": "Device category the action came from (mobile/tablet/desktop)"
    }
  },
  "required": [
    "user_email",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}
{
  "name": "ScheduledSignatureReminder",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Immutable tenant id copied from the exact signature package."
    },
    "package_id": {
      "type": "string",
      "description": "Exact authority-bound DocumentPackage to notify."
    },
    "signer_id": {
      "type": "string",
      "description": "Opaque signer id; dispatch re-derives the address from the current package/signature state."
    },
    "schedule_key": {
      "type": "string",
      "description": "Server-built SHA-256 idempotency key scoped to agency, package, signer, and request id."
    },
    "client_request_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "description": "Id of the DocumentSignature request this reminder is for"
    },
    "document_name": {
      "type": "string",
      "description": "Snapshot of the document name for display in queues"
    },
    "deadline_date": {
      "type": "string",
      "format": "date-time",
      "description": "Signature deadline the reminder message references"
    },
    "send_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reminder notifications should be delivered"
    },
    "requested_by": {
      "type": "string",
      "description": "Email of the user who scheduled the reminder (rows are created via service role, so created_by is not the scheduler)"
    },
    "requested_by_user_id": {
      "type": "string",
      "description": "Immutable built-in User id of the scheduler."
    },
    "requesting_membership_id": {
      "type": "string"
    },
    "requesting_membership_version": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_audit",
        "pending",
        "sending",
        "sent",
        "indeterminate",
        "failed",
        "canceled"
      ],
      "default": "pending_audit",
      "description": "Scheduled reminder status. New rows remain pending_audit and cannot dispatch until their immutable audit event is durably verified."
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of dispatch attempts made"
    },
    "claimed_by": {
      "type": "string",
      "description": "Per-run token claiming this row for dispatch (concurrency guard)"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this row was claimed for dispatch"
    },
    "authority_version": {
      "type": "number",
      "default": 1,
      "description": "Monotonic revision used for exact conditional dispatch transitions."
    },
    "audit_event_id": {
      "type": "string",
      "description": "Exact SignatureAuditEvent whose durable readback made this reminder dispatchable."
    },
    "audit_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp when audit_event_id was verified and status changed from pending_audit to pending."
    },
    "delivery_attempt_id": {
      "type": "string",
      "description": "Opaque id for the single external email attempt."
    },
    "delivery_state": {
      "type": "string",
      "enum": ["not_started", "pending", "accepted", "indeterminate", "rejected"],
      "default": "not_started"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reminder notifications were actually created"
    },
    "reminder_count": {
      "type": "number",
      "description": "Number of signer notifications created when dispatched"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for failure or cancellation if applicable"
    },
    "canceled_by": {
      "type": "string",
      "description": "Email of the user who canceled the scheduled reminder"
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scheduled reminder was canceled"
    }
  },
  "required": [
    "document_id",
    "send_at"
  ],
  // Signature scheduling and dispatch are quarantined. Direct access is denied;
  // reviewed service-role offboarding may still cancel historical rows.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

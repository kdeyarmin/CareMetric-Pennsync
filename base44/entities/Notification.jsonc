{
  "name": "Notification",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Server-stamped Agency id for tenant-bound workflow notifications. Legacy notifications may not have this field."
    },
    "dedupe_key": {
      "type": "string",
      "description": "Server-derived idempotency key for a purpose-specific notification workflow. Code must still reject duplicate rows because schema uniqueness is not assumed."
    },
    "recipient_user_id": {
      "type": "string",
      "description": "Immutable built-in Base44 User id of the recipient. Secure workflow notifications must bind this to an exact active membership before creation."
    },
    "recipient_membership_id": {
      "type": "string",
      "description": "Exact AgencyMembership id that authorized delivery to the recipient. Legacy/unscoped notifications may not have this field and are excluded from the secure recipient broker."
    },
    "recipient_membership_version": {
      "type": "integer",
      "minimum": 1,
      "description": "AgencyMembership revision that authorized delivery. The recipient broker requires it to match the current active membership."
    },
    "authority_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Server-owned notification authority format. Version 1 requires immutable tenant, user, and membership provenance."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic server-maintained revision used for conditional recipient read-state and dismissal updates."
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who should receive this notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "type": {
      "type": "string",
      "enum": [
        "report_ready",
        "compliance_alert",
        "critical_alert",
        "patient_alert",
        "task_assigned",
        "task_due_soon",
        "new_referral",
        "referral_urgent",
        "training_due",
        "system_update",
        "message_received",
        "sms_failed",
        "sms_urgent",
        "sms_received",
        "fax_delivered",
        "fax_failed",
        "voicemail",
        "info",
        "expiration_warning",
        "credential_expiration",
        "admin_expiration_summary",
        "care_plan_proposal",
        "signature_request"
      ],
      "description": "Type of notification"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Notification priority"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was read"
    },
    "action_url": {
      "type": "string",
      "description": "Optional URL to navigate to when clicked"
    },
    "action_label": {
      "type": "string",
      "description": "Label for action button"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the notification (patient_id, referral_id, task_id, etc.)"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether email notification was sent"
    },
    "push_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether push notification was sent"
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user dismissed this notification"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp written by the recipient notification broker when the row was dismissed."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notification should be auto-archived"
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}

{
  "name": "TrainingFeedback",
  "type": "object",
  "properties": {
    "feedback_type": {
      "type": "string",
      "enum": [
        "module_rating",
        "content_issue",
        "general_feedback"
      ],
      "description": "Type of feedback"
    },
    "training_module_id": {
      "type": "string",
      "description": "Reference to TrainingModule if feedback is about a specific module"
    },
    "module_title": {
      "type": "string",
      "description": "Title of the training module for reference"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Module rating (1-5 stars)"
    },
    "effectiveness_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "How effective the module was"
    },
    "relevance_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "How relevant the module was to their work"
    },
    "difficulty_rating": {
      "type": "string",
      "enum": [
        "too_easy",
        "just_right",
        "too_hard"
      ],
      "description": "Difficulty assessment"
    },
    "issue_category": {
      "type": "string",
      "enum": [
        "technical",
        "content_accuracy",
        "clarity",
        "outdated",
        "broken_link",
        "other"
      ],
      "description": "Category of content issue"
    },
    "issue_description": {
      "type": "string",
      "description": "Detailed description of the issue"
    },
    "feedback_text": {
      "type": "string",
      "description": "General feedback or comments"
    },
    "would_recommend": {
      "type": "boolean",
      "description": "Whether they would recommend this module"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "addressed",
        "dismissed"
      ],
      "default": "new",
      "description": "Status of the feedback"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin review"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed the feedback"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When feedback was reviewed"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user providing feedback"
    },
    "user_name": {
      "type": "string",
      "description": "Name of user providing feedback"
    },
    "course_id": {
      "type": "string",
      "description": "ID of the course this feedback is about; written and read (filter/aggregate) by submitCourseFeedback/getCourseFeedbackSummary"
    },
    "course_title": {
      "type": "string",
      "description": "Title of the course for reference (distinct from module_title)"
    },
    "comment": {
      "type": "string",
      "description": "Free-text feedback comment (distinct from feedback_text)"
    },
    "difficulty": {
      "type": "string",
      "description": "Difficulty assessment as submitted (distinct from difficulty_rating enum)"
    },
    "user_id": {
      "type": "string",
      "description": "Email of the user submitting course feedback; written and read by submitCourseFeedback/getCourseFeedbackSummary"
    }
  },
  "required": [
    "feedback_type",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
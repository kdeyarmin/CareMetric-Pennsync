{
  "name": "OASISUpload",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "patient_name": {
      "type": "string",
      "description": "Patient name from OASIS document"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded OASIS PDF"
    },
    "file_name": {
      "type": "string",
      "description": "Original filename"
    },
    "assessment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of OASIS assessment"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "SOC",
        "ROC",
        "Recertification",
        "Follow-up",
        "Transfer",
        "Discharge",
        "Other"
      ],
      "description": "Type of OASIS assessment"
    },
    "analysis_id": {
      "type": "string",
      "description": "Unique identifier for this analysis session"
    },
    "pdgm_data": {
      "type": "object",
      "description": "Extracted PDGM-relevant data from OASIS"
    },
    "analysis_results": {
      "type": "object",
      "description": "Full AI analysis results"
    },
    "scores": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "compliance": {
          "type": "number"
        },
        "revenue_optimization": {
          "type": "number"
        }
      },
      "description": "Analysis scores"
    },
    "estimated_payment": {
      "type": "number",
      "description": "Estimated PDGM payment amount (ORIGINAL, as originally documented)"
    },
    "optimized_payment": {
      "type": "number",
      "description": "Estimated PDGM payment after the analyzer's documentation corrections (the 'after' figure). Absent when no corrected scenario was computed. Financial field — stripped for non-financial users by listOASISUploads."
    },
    "revenue_uplift": {
      "type": "number",
      "description": "optimized_payment − estimated_payment: the reimbursement impact of the documentation corrections for this assessment. Financial field — stripped for non-financial users."
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "analyzed",
        "reviewed",
        "archived"
      ],
      "default": "uploaded"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this OASIS"
    },
    "extracted_data": {
      "type": "object",
      "description": "Extracted/edited OASIS field data (item values, AI suggestions, supervisor approvals)"
    },
    "supervisor_review_status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ],
      "description": "Supervisor approval decision for this OASIS"
    },
    "supervisor_reviewed_by": {
      "type": "string",
      "description": "Email of supervisor who reviewed this OASIS"
    },
    "supervisor_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the supervisor review was recorded"
    },
    "comprehensive_review": {
      "type": "object",
      "description": "Persisted Comprehensive OASIS Review (AI): { results, reviewed_at }. Stored so reopening a saved upload restores the review instead of re-running the billed LLM call. Nested revenue/payment keys inside results are financial — stripped for non-financial users by listOASISUploads."
    }
  },
  "required": [
    "file_url"
  ],
  // PHI read-scoping: with no read rule, ANY authenticated user could bulk-
  // .list() every row (an OASIS upload carries the full assessment extract for a patient).
  // Reads are scoped to the owning user (+ admin), matching the app's
  // Patient/Visit/ComplianceAudit role model: non-admin staff see only their
  // own rows on agency-wide report surfaces; admins see everything. "write": {}
  // deliberately preserves the existing open write behavior — this change is
  // read-scoping only (several write flows are legitimately cross-user), the
  // same shape as the ClinicalLibraryTemplate read-scoping fix.
  "rls": {
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "write": {}
  }
}

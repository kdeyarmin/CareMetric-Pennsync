{
  "name": "Incident",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "visit_id": {
      "type": "string",
      "description": "Reference to Visit entity"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "fall",
        "hospitalized",
        "medication_error",
        "behavioral_change",
        "infection_suspected",
        "refusal_of_care",
        "pressure_injury",
        "emergency_visit",
        "other"
      ],
      "description": "Type of incident"
    },
    "incident_name": {
      "type": "string",
      "description": "Display name of incident"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Date incident occurred"
    },
    "incident_time": {
      "type": "string",
      "description": "Time incident occurred"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Severity level"
    },
    "details": {
      "type": "object",
      "description": "Incident-specific details"
    },
    "report": {
      "type": "string",
      "description": "Full incident report text"
    },
    "physician_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether physician was notified"
    },
    "office_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether office was notified"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "under_review",
        "resolved"
      ],
      "default": "reported",
      "description": "Incident status"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notes on how incident was resolved"
    },
    "ai_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-generated tags for categorization and trend analysis"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    },
    "patient_name": {
      "type": "string",
      "description": "Patient display name captured on the incident (denormalized for reporting)"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of photos uploaded with the incident report"
    },
    "alert_triggered": {
      "type": "boolean",
      "default": false,
      "description": "Whether an automated alert was triggered for this incident"
    },
    "state_reportable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this incident is a state-reportable event (read top-level by the review queue and reporting module)"
    },
    "state_reportable_pdf_url": {
      "type": "string",
      "description": "URL of the generated state-reportable incident PDF"
    },
    "state_reportable_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the state-reportable alert was sent"
    }
  },
  "required": [
    "patient_id",
    "incident_type",
    "incident_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "CarePlanCollaboration",
  "type": "object",
  "properties": {
    "care_plan_id": {
      "type": "string",
      "description": "Reference to CarePlan"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient"
    },
    "provider_email": {
      "type": "string",
      "description": "Email of collaborating provider"
    },
    "provider_name": {
      "type": "string",
      "description": "Name of collaborating provider"
    },
    "provider_type": {
      "type": "string",
      "description": "Type of provider (RN, PT, MSW, etc.)"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "collaborator",
        "viewer"
      ],
      "default": "collaborator",
      "description": "Provider's role in this care plan"
    },
    "added_date": {
      "type": "string",
      "format": "date-time",
      "description": "When provider was added"
    },
    "contribution": {
      "type": "string",
      "description": "Provider's specific contribution/focus area"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last time provider updated the plan"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Provider's collaborative notes"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "care_plan_id",
    "patient_id",
    "provider_email",
    "provider_type",
    "role"
  ]
}
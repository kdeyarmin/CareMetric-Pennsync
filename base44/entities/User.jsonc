{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "agency_admin"
      ],
      "default": "user"
    },
    "favorited_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of page names the user has favorited"
    },
    "favorited_patients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of patient IDs the user has favorited"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "RN",
        "LPN"
      ],
      "default": "RN"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "home_health",
        "hospice"
      ],
      "default": "home_health"
    },
    "preferred_language": {
      "type": "string",
      "default": "en-US"
    },
    "phone_number": {
      "type": "string"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "description": "Unique code for user referrals"
    },
    "data_retention_preference": {
      "type": "string",
      "enum": [
        "save",
        "delete_after_7_days",
        "delete_after_30_days"
      ],
      "default": "save"
    },
    "notification_settings": {
      "type": "object",
      "properties": {
        "email_updates": {
          "type": "boolean",
          "default": true
        },
        "sms_alerts": {
          "type": "boolean",
          "default": false
        },
        "in_app_notifications": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "sending_fax_number": {
      "type": "string",
      "description": "Dedicated fax number for sending faxes from the app"
    },
    "fax_notification_preferences": {
      "type": "object",
      "properties": {
        "notify_on_sent": {
          "type": "boolean",
          "default": true
        },
        "notify_on_delivered": {
          "type": "boolean",
          "default": true
        },
        "notify_on_failed": {
          "type": "boolean",
          "default": true
        },
        "channels": {
          "type": "object",
          "properties": {
            "in_app": {
              "type": "boolean",
              "default": true
            },
            "email": {
              "type": "boolean",
              "default": true
            },
            "sms": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "description": "User preferences for fax status notifications"
    },
    "agency_id": {
      "type": "string",
      "description": "Agency ID for enterprise users"
    },
    "agency_role": {
      "type": "string",
      "enum": [
        "nurse",
        "supervisor",
        "director"
      ],
      "default": "nurse",
      "description": "Role within the agency"
    }
  },
  "required": [
    "favorited_pages",
    "favorited_patients",
    "phone_number",
    "referral_code",
    "notification_settings",
    "sending_fax_number"
  ]
}
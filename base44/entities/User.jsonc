{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "agency_admin"
      ],
      "default": "user"
    },
    "favorited_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of page names the user has favorited"
    },
    "favorited_patients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of patient IDs the user has favorited"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "RN",
        "LPN"
      ],
      "default": "RN"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "home_health",
        "hospice"
      ],
      "default": "home_health"
    },
    "preferred_language": {
      "type": "string",
      "default": "en-US"
    },
    "phone_number": {
      "type": "string"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "description": "Unique code for user referrals"
    },
    "data_retention_preference": {
      "type": "string",
      "enum": [
        "save",
        "delete_after_7_days",
        "delete_after_30_days"
      ],
      "default": "save"
    },
    "notification_settings": {
      "type": "object",
      "properties": {
        "email_updates": {
          "type": "boolean",
          "default": true
        },
        "sms_alerts": {
          "type": "boolean",
          "default": false
        },
        "in_app_notifications": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "sending_fax_number": {
      "type": "string",
      "description": "Dedicated fax number for sending faxes from the app"
    },
    "fax_notification_preferences": {
      "type": "object",
      "properties": {
        "notify_on_sent": {
          "type": "boolean",
          "default": true
        },
        "notify_on_delivered": {
          "type": "boolean",
          "default": true
        },
        "notify_on_failed": {
          "type": "boolean",
          "default": true
        },
        "channels": {
          "type": "object",
          "properties": {
            "in_app": {
              "type": "boolean",
              "default": true
            },
            "email": {
              "type": "boolean",
              "default": true
            },
            "sms": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "description": "User preferences for fax status notifications"
    },
    "agency_id": {
      "type": "string",
      "description": "Legacy tenant display/migration hint only. AgencyMembership is the server-owned authorization source; never authorize from this self-editable profile field."
    },
    "agency_name": {
      "type": "string",
      "description": "Legacy tenant display/settings hint only. This custom profile field is self-editable and must never grant authorization; AgencyMembership is authoritative."
    },
    "agency_role": {
      "type": "string",
      "enum": [
        "nurse",
        "supervisor",
        "director"
      ],
      "default": "nurse",
      "description": "Role within the agency"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user account is active"
    },
    "phone": {
      "type": "string",
      "description": "User phone number (distinct from phone_number; this is the field read/written across the app)"
    },
    "license_number": {
      "type": "string",
      "description": "Professional license number"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has been approved for access"
    },
    "is_manager": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is a manager"
    },
    "manager_email": {
      "type": "string",
      "description": "Email of this user's manager"
    },
    "profile_completeness_score": {
      "type": "number",
      "description": "Computed profile completeness score (0-100)"
    },
    "account_type": {
      "type": "string",
      "description": "Legacy presentation/migration label only. This custom profile field is self-editable and must never grant authorization."
    },
    "care_scope": {
      "type": "string",
      "description": "Service line scope the user covers (home_health, hospice, both); distinct from service_type"
    },
    "staff_role": {
      "type": "string",
      "enum": [
        "nurse",
        "office_staff",
        "social_worker",
        "spiritual_care"
      ],
      "default": "nurse",
      "description": "Staff discipline that drives which functions are visible. 'nurse' (default) and admins see clinical + nursing tools (OASIS, clinical notes, care plans). 'social_worker' and 'spiritual_care' can view patients/records but not nursing tools. 'office_staff' sees only non-clinical functions (learning, PTO, messaging, resources). Orthogonal to admin role/account_type tiers."
    },
    "credentials": {
      "type": "string",
      "description": "Free-text professional credentials (distinct from credential_type enum)"
    },
    "duty_status": {
      "type": "string",
      "description": "Nurse duty status (on_duty/off_duty)"
    },
    "duty_on_since": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the nurse toggled on duty"
    },
    "off_duty_message": {
      "type": "string",
      "description": "Auto-reply message shown while off duty"
    },
    "scheduled_off_duty_start": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled off-duty window start (ISO timestamp)"
    },
    "scheduled_off_duty_end": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled off-duty window end (ISO timestamp)"
    },
    "scheduled_off_duty_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether the scheduled off-duty window recurs"
    },
    "work_phone_number": {
      "type": "string",
      "description": "Legacy cached work number (E.164). It is not provider-routing authority; a service-owned telecom binding is required before delegated sends/calls are enabled."
    },
    "twilio_phone_number_sid": {
      "type": "string",
      "description": "Legacy provider number identifier cache; never authorization or routing authority."
    },
    "personal_cell_e164": {
      "type": "string",
      "description": "Legacy cached nurse cell (E.164). It is not provider-routing authority pending a service-owned telecom binding."
    },
    "ai_content_agreement_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Legacy display/compatibility field only; never authorization or agreement-gate authority"
    },
    "ai_content_agreement_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy display/compatibility timestamp only; never agreement-gate authority"
    },
    "ai_content_agreement_version": {
      "type": "string",
      "description": "Legacy display/compatibility version only; the service-owned AIContentAgreementAttestation controls re-prompting"
    },
    "offboarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when an admin deactivated/offboarded this user"
    },
    "offboarded_by": {
      "type": "string",
      "description": "Admin email that offboarded this user"
    },
    "offboarding_reason": {
      "type": "string",
      "description": "Reason recorded by the admin when deactivating this user"
    },
    // Written by FaxSignaturePanel via auth.updateMe and read back as
    // currentUser.saved_signature. It was missing here, so Base44 dropped the
    // write and "Signature saved to your profile" was never true — the pad came
    // up blank on every fax.
    "saved_signature": {
      "type": "string",
      "description": "Data URL of the user's reusable signature image for fax cover sheets and document signing"
    }
  },
  "required": [
    "favorited_pages",
    "favorited_patients",
    "phone_number",
    "referral_code",
    "notification_settings",
    "sending_fax_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

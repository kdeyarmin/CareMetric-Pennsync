{
  "name": "PatientEducationAssignment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "material_id": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of provider who assigned"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "in_progress",
        "completed",
        "dismissed"
      ],
      "default": "assigned"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Why this was assigned"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "topic": {
      "type": "string",
      "description": "Education topic"
    },
    "content": {
      "type": "string",
      "description": "Education content or summary"
    },
    "format": {
      "type": "string",
      "description": "Delivery format (e.g. handout, video)"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "Date the education was assigned"
    },
    "materials_provided": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key points / materials provided to the patient"
    },
    "care_plan_id": {
      "type": "string",
      "description": "Reference to the care plan this education is tied to"
    },
    "comprehension_verified": {
      "type": "boolean",
      "description": "Whether patient comprehension was verified"
    },
    "teach_back_notes": {
      "type": "string",
      "description": "Teach-back verification notes"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the education was completed"
    }
  },
  // AI-generated education (AIEducationRecommender, CarePlanManagement) creates
  // by topic/content without a material library id, so material_id is not
  // required; patient_id + assigned_by are common to both shapes.
  "required": [
    "patient_id",
    "assigned_by"
  ]
}
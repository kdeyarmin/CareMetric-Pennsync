{
  "name": "PatientEducationAssignment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "material_id": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of provider who assigned"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "in_progress",
        "completed",
        "dismissed"
      ],
      "default": "assigned"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Why this was assigned"
    },
    "related_care_plan_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    }
  },
  "required": [
    "patient_id",
    "material_id",
    "assigned_by"
  ]
}
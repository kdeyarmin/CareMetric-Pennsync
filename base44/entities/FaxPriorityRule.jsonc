{
  "name": "FaxPriorityRule",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Rule name"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "keyword",
        "sender",
        "recipient"
      ],
      "description": "What this rule matches against"
    },
    "pattern": {
      "type": "string",
      "description": "Text pattern to match"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "notify": {
      "type": "boolean",
      "default": false,
      "description": "Send notification when this rule matches"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "match_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this rule has matched"
    }
  },
  "required": [
    "user_email",
    "name",
    "rule_type",
    "pattern",
    "priority"
  ]
}
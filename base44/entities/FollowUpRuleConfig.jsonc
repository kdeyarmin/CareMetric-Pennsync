{
  "name": "FollowUpRuleConfig",
  "type": "object",
  // Agency-editable configuration for the referral follow-up review engine
  // (src/components/referral/referralFollowUpEngine.js — applyRuleConfig).
  // The built-in rules are the floor; this lets an agency disable rules that
  // don't apply to them, tighten severities, and add their own request items.
  // Written ONLY through the admin-gated saveFollowUpRuleConfig function
  // (service-role write). Browser reads are paused until an immutable
  // membership-scoped read broker exists; callers safely use the built-in
  // review rules in the meantime.
  "properties": {
    "disabled_rules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rule ids (see FOLLOW_UP_RULES) the agency has turned off"
    },
    "severity_overrides": {
      "type": "object",
      "description": "Map of rule id -> severity (critical|high|medium) overriding the default"
    },
    "custom_items": {
      "type": "array",
      "description": "Agency-defined request items: { title, question, category (compliance|reimbursement), severity, why, citation?, impact?, hint?, response_type? }"
    },
    "updated_by_email": {
      "type": "string",
      "description": "Email of the admin who last saved this configuration"
    },
    "agency_name": {
      "type": "string",
      "description": "Tenant agency this config belongs to. saveFollowUpRuleConfig filters/updates by this so multi-tenant admins cannot clobber another agency's row."
    }
  },
  "required": [],
  "rls": {
    "read": false,
    "create": {
      "user_condition": { "role": "__service_role_only__" }
    },
    "update": {
      "user_condition": { "role": "__service_role_only__" }
    },
    "delete": {
      "user_condition": { "role": "__service_role_only__" }
    }
  }
}

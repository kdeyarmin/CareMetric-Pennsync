{
  "name": "OCRTrainingSession",
  "type": "object",
  "properties": {
    "admin_email": {
      "type": "string",
      "description": "Admin who triggered the training"
    },
    "feedback_count": {
      "type": "number",
      "description": "Number of feedback items processed"
    },
    "accuracy_before": {
      "type": "number",
      "description": "Estimated accuracy before training"
    },
    "accuracy_after": {
      "type": "number",
      "description": "Estimated accuracy after training"
    },
    "improvement_percentage": {
      "type": "number",
      "description": "Percentage improvement"
    },
    "patterns_learned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key patterns identified from corrections"
    },
    "ai_insights": {
      "type": "string",
      "description": "AI-generated insights about correction patterns"
    },
    "correction_categories": {
      "type": "object",
      "description": "Breakdown of corrections by type"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "failed"
      ],
      "default": "processing"
    }
  },
  "required": [
    "admin_email",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
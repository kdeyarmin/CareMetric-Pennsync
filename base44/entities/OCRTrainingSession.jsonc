{
  "name": "OCRTrainingSession",
  "type": "object",
  "properties": {
    "feedback_count": {
      "type": "number",
      "description": "Number of feedback items processed"
    },
    "accuracy_before": {
      "type": "number",
      "description": "Estimated accuracy before training"
    },
    "accuracy_after": {
      "type": "number",
      "description": "Estimated accuracy after training"
    },
    "improvement_percentage": {
      "type": "number",
      "description": "Percentage improvement"
    },
    "patterns_learned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key patterns identified from corrections"
    },
    "ai_insights": {
      "type": "string",
      "description": "AI-generated insights about correction patterns"
    },
    "correction_categories": {
      "type": "object",
      "description": "Breakdown of corrections by type"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "processing"
    },
    "session_name": {
      "type": "string",
      "description": "Human-readable name of the training session; read by OCRTrainingMonitor"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the training session started (ISO timestamp)"
    },
    "document_types_trained": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Distinct document types covered by the corrections in this session"
    },
    "training_metrics": {
      "type": "object",
      "description": "Aggregate correction metrics (minor/moderate/major counts, avg_correction_length)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the training session completed (ISO timestamp)"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if the training session failed"
    },
    "initiated_by": {
      "type": "string",
      "description": "Email of the admin who initiated the session as written by retrainOCRModel (distinct from admin_email)"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
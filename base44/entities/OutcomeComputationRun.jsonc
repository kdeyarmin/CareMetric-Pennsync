{
  "name": "OutcomeComputationRun",
  "type": "object",
  "description": "Server-only publication gate for one computeOutcomeMeasures attempt. PatientOutcomeMetric and AgencyKPI rows carrying this run id are authoritative only when this record is published.",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Immutable tenant scope copied from the internal request."
    },
    "run_key": {
      "type": "string",
      "description": "SHA-256 of tenant, reporting window, calculation version, and caller-supplied idempotency key. The raw idempotency key is never stored."
    },
    "window_key": {
      "type": "string",
      "description": "SHA-256 of tenant and reporting-window identity. Until Base44 provides an atomic publication pointer, the function fails closed instead of publishing a second run for this logical window."
    },
    "attempt_id": {
      "type": "string",
      "description": "Unique execution attempt. Derived rows are append-only and carry both this attempt id and this run record id."
    },
    "status": {
      "type": "string",
      "enum": ["building", "published", "failed", "superseded"]
    },
    "publication_mode": {
      "type": "string",
      "enum": ["single_run_record_gate_v1"],
      "description": "A single status transition on this run publishes the complete staged generation; per-row flags are not publication signals."
    },
    "period_type": {
      "type": "string",
      "enum": ["daily", "weekly", "monthly", "quarterly", "yearly", "custom"]
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "calculation_version": {
      "type": "string"
    },
    "benchmark_value": {
      "type": "number",
      "description": "Optional internal comparison threshold included in the idempotency scope."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_stage": {
      "type": "string",
      "description": "Coarse non-sensitive stage name for an unpublished failed attempt."
    },
    "patient_outcome_metric_count": {
      "type": "number"
    },
    "agency_kpi_count": {
      "type": "number"
    },
    "generation_fingerprint": {
      "type": "string",
      "description": "SHA-256 of the planned metric/KPI generation with execution-specific run ids removed. This supports audit comparison without storing source PHI in the run record."
    },
    "result_summary": {
      "type": "object",
      "description": "Non-PHI response summary returned verbatim on an idempotent replay."
    }
  },
  "required": [
    "agency_id",
    "run_key",
    "window_key",
    "attempt_id",
    "status",
    "publication_mode",
    "period_type",
    "period_start",
    "period_end",
    "calculation_version",
    "started_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

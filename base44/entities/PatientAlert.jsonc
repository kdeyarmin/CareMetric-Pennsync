{
  "name": "PatientAlert",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "vital_deterioration",
        "medication_risk",
        "fall_risk",
        "readmission_risk",
        "infection_risk",
        "symptom_escalation",
        "care_gap",
        "urgent_intervention",
        "hospice_transition",
        "caregiver_burnout",
        "vital_sign_threshold",
        "lab_result_critical",
        "missed_visit",
        "medication_adherence",
        "weight_change",
        "pain_level",
        "functional_decline",
        "care_plan_stalled",
        "overdue_task",
        "hospitalization_risk",
        "predictive_risk",
        "documentation_risk"
      ],
      "description": "Type of alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Alert severity level"
    },
    "title": {
      "type": "string",
      "description": "Brief alert title"
    },
    "message": {
      "type": "string",
      "description": "Detailed alert message"
    },
    "description": {
      "type": "string",
      "description": "Detailed alert description"
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Factors that triggered this alert"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended actions to address the alert"
    },
    "risk_score": {
      "type": "number",
      "description": "Calculated risk score (0-100)"
    },
    "data_sources": {
      "type": "object",
      "description": "Data points that contributed to the alert"
    },
    "triggered_data": {
      "type": "object",
      "description": "Specific data that triggered the alert"
    },
    "triggered_by_rule_id": {
      "type": "string",
      "description": "ID of AlertTriggerRule that created this alert"
    },
    "detected_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert condition was detected"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "in_progress",
        "resolved",
        "dismissed"
      ],
      "default": "active"
    },
    "flagged_urgent": {
      "type": "boolean",
      "default": false,
      "description": "Flagged for immediate nurse attention"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned nurse"
    },
    "acknowledged_by": {
      "type": "string",
      "description": "Email of nurse who acknowledged"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notes on how alert was resolved"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When alert auto-expires if not addressed"
    }
  },
  "required": [
    "patient_id",
    "alert_type",
    "severity",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
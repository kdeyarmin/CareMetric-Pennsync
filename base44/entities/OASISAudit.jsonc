{
  "name": "OASISAudit",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user who performed analysis"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "compliant",
        "flagged",
        "critical"
      ],
      "description": "Overall status of OASIS assessment"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of analysis"
    },
    "details": {
      "type": "object",
      "description": "Full AI analysis results"
    },
    "oasis_file_url": {
      "type": "string",
      "description": "URL to uploaded OASIS file"
    },
    "analysis_date": {
      "type": "string",
      "format": "date-time",
      "description": "When analysis was performed"
    },
    "completeness_score": {
      "type": "number",
      "description": "OASIS data completeness score (0-100)"
    },
    "accuracy_score": {
      "type": "number",
      "description": "OASIS data accuracy score (0-100)"
    },
    "missing_data_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "oasis_item": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          },
          "impact_on_reimbursement": {
            "type": "boolean"
          }
        }
      },
      "description": "Identified missing critical data points"
    },
    "accuracy_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "oasis_item": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "suggested_value": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      },
      "description": "Flags for potentially inaccurate data"
    },
    "predictive_summary": {
      "type": "string",
      "description": "AI-generated summary of predicted patient outcomes/risks"
    },
    "care_plan_summary": {
      "type": "string",
      "description": "AI-generated care plan recommendations"
    },
    "risk_scores": {
      "type": "object",
      "properties": {
        "hospitalization_risk": {
          "type": "number"
        },
        "fall_risk": {
          "type": "number"
        },
        "functional_decline_risk": {
          "type": "number"
        },
        "wound_healing_risk": {
          "type": "number"
        }
      },
      "description": "Predictive risk scores based on OASIS data"
    },
    "predicted_los": {
      "type": "number",
      "description": "Predicted length of service in days"
    }
  },
  "required": [
    "user_email",
    "status",
    "summary"
  ]
}
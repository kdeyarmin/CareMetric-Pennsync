{
  "name": "OCRFeedback",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who provided correction"
    },
    "fax_history_id": {
      "type": "string",
      "description": "Related FaxHistory record"
    },
    "document_url": {
      "type": "string",
      "description": "URL of the document"
    },
    "original_text": {
      "type": "string",
      "description": "Original OCR output"
    },
    "corrected_text": {
      "type": "string",
      "description": "User-corrected text"
    },
    "correction_type": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "major"
      ],
      "description": "Severity of correction"
    },
    "document_type": {
      "type": "string",
      "description": "Type of document for categorization"
    },
    "is_applied": {
      "type": "boolean",
      "default": false,
      "description": "Whether this feedback has been used for retraining"
    },
    "training_session_id": {
      "type": "string",
      "description": "ID of the training session that used this feedback"
    }
  },
  "required": [
    "user_email",
    "original_text",
    "corrected_text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {}
  }
}
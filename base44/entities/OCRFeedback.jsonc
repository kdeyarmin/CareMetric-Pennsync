{
  "name": "OCRFeedback",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who provided correction"
    },
    "document_url": {
      "type": "string",
      "description": "URL of the document"
    },
    "original_text": {
      "type": "string",
      "description": "Original OCR output"
    },
    "corrected_text": {
      "type": "string",
      "description": "User-corrected text"
    },
    "correction_type": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "major"
      ],
      "description": "Severity of correction"
    },
    "document_type": {
      "type": "string",
      "description": "Type of document for categorization"
    },
    "training_session_id": {
      "type": "string",
      "description": "ID of the training session that used this feedback"
    },
    "feedback_notes": {
      "type": "string",
      "description": "Reviewer notes about the OCR correction; read by OCRFeedbackDashboard"
    },
    "applied_to_training": {
      "type": "boolean",
      "default": false,
      "description": "Whether this feedback has been applied to retraining; written/filtered/read by retrainOCRModel and OCR dashboards (distinct from is_applied)"
    },
    "fax_log_id": {
      "type": "string",
      "description": "Related FaxLog record id as written by OCRReviewPanel (distinct from fax_history_id)"
    },
    "original_ocr_text": {
      "type": "string",
      "description": "Original OCR output as written by OCRReviewPanel; read by retrainOCRModel (distinct from original_text)"
    },
    "corrected_by": {
      "type": "string",
      "description": "Email of the user who made the correction as written by OCRReviewPanel (distinct from user_email)"
    }
  },
  "required": [
    "user_email",
    "original_text",
    "corrected_text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {}
  }
}
{
  "name": "CarePlan",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to CarePlanTemplate if created from template"
    },
    "problem": {
      "type": "string",
      "description": "Clinical problem/nursing diagnosis"
    },
    "goal": {
      "type": "string",
      "description": "Measurable goal"
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Planned interventions"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Expected achievement date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "met",
        "not_met",
        "revised"
      ],
      "default": "active"
    },
    "baseline_measurement": {
      "type": "string",
      "description": "Initial measurement for tracking progress"
    },
    "current_measurement": {
      "type": "string",
      "description": "Most recent measurement value"
    },
    "frequency": {
      "type": "string",
      "description": "How often to assess (e.g., weekly, each visit)"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled review date"
    },
    "last_reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "Last time plan was reviewed"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Estimated progress toward goal (0-100)"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of provider emails who collaborate on this plan"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    }
  },
  "required": [
    "patient_id",
    "problem",
    "goal"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "FleetVehicle",
  "type": "object",
  "description": "Company vehicle inventory, administered through the tenant-authorized vehicle-maintenance broker. No patient information.",
  "properties": {
    "creation_claim_token": {
      "type": "string",
      "description": "Matches the winning server-owned vehicle creation reservation."
    },
    "service_creation_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "token"
        ]
      },
      "description": "Service-owned permanent ordered request reservations. Append with native $push only; never replace, reorder, clear, or expire after an uncertain create."
    },
    "agency_id": {
      "type": "string"
    },
    "unit_name": {
      "type": "string",
      "description": "Company car/unit name employees recognize."
    },
    "year": {
      "type": "number"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "vin": {
      "type": "string"
    },
    "license_plate": {
      "type": "string"
    },
    "baseline_odometer": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "out_of_service",
        "retired"
      ],
      "default": "active"
    },
    "assigned_user_id": {
      "type": "string"
    },
    "assigned_user_name": {
      "type": "string"
    },
    "assigned_user_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "request_key": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agency_id",
    "unit_name",
    "make",
    "model",
    "status",
    "version",
    "request_key",
    "created_by_user_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
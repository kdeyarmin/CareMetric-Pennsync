{
  "name": "ClinicalPathway",
  "type": "object",
  "properties": {
    "pathway_name": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "description": "Primary condition this pathway addresses"
    },
    "icd10_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_name": {
            "type": "string"
          },
          "duration_days": {
            "type": "number"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interventions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "discipline": {
                  "type": "string"
                },
                "intervention": {
                  "type": "string"
                },
                "frequency": {
                  "type": "string"
                }
              }
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "typical_los": {
      "type": "number",
      "description": "Typical length of service in days"
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Expert Opinion"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "success_rate": {
      "type": "number",
      "description": "% of patients achieving pathway goals"
    },
    "created_by": {
      "type": "string"
    },
    "trigger_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          }
        }
      },
      "description": "Conditions (diagnosis code/keyword) that trigger this pathway"
    },
    "pdgm_clinical_group": {
      "type": "string",
      "description": "Target PDGM clinical grouping (e.g. MMTA_Cardiac_Circulatory)"
    },
    "priority_level": {
      "type": "string",
      "description": "Priority level of this pathway (e.g. high, medium, low)"
    },
    "documentation_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "m_items_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string"
          }
        }
      },
      "description": "Documentation prompts to surface for this pathway"
    },
    "rescore_opportunities": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Opportunities to improve PDGM scoring"
    },
    "recommended_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Recommended tasks for this pathway"
    },
    "comorbidity_checklist": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Comorbidity items to check for this pathway"
    },
    "functional_focus_areas": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Functional focus areas for this pathway"
    }
  },
  "required": [
    "pathway_name",
    "condition"
  ]
}
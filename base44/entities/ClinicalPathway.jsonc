{
  "name": "ClinicalPathway",
  "type": "object",
  "properties": {
    "pathway_name": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "description": "Primary condition this pathway addresses"
    },
    "icd10_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_name": {
            "type": "string"
          },
          "duration_days": {
            "type": "number"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interventions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "discipline": {
                  "type": "string"
                },
                "intervention": {
                  "type": "string"
                },
                "frequency": {
                  "type": "string"
                }
              }
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "typical_los": {
      "type": "number",
      "description": "Typical length of service in days"
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Expert Opinion"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "success_rate": {
      "type": "number",
      "description": "% of patients achieving pathway goals"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "pathway_name",
    "condition"
  ]
}
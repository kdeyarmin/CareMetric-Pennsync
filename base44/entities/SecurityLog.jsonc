{
  "name": "SecurityLog",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who performed action"
    },
    "user_role": {
      "type": "string",
      "description": "Role of user at time of action"
    },
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "details": {
      "type": "object",
      "description": "Additional details about the action"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of request"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent"
    }
  },
  "required": [
    "timestamp",
    "user_email",
    "action"
  ],
  // 2026-10-08 owner decision: the record's creator or an administrator may
  // read a row; rows stay append-only through service-role writers, so every
  // browser create, update and delete is still refused.
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}

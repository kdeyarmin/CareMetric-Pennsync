{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "User ID of the person who made the referral"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the person who made the referral"
    },
    "referred_user_id": {
      "type": "string",
      "description": "User ID of the person who was referred"
    },
    "referred_user_email": {
      "type": "string",
      "description": "Email of the person who was referred"
    },
    "referral_code_used": {
      "type": "string",
      "description": "The referral code that was used"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "trial_started",
        "converted_to_paid",
        "reward_issued"
      ],
      "default": "pending",
      "description": "Current status of the referral"
    },
    "reward_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount of credit issued for this referral (in dollars)"
    },
    "reward_issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the reward was issued to the referrer"
    },
    "converted_to_paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the referred user converted to a paid subscription"
    }
  },
  "required": [
    "referrer_id",
    "referrer_email",
    "referred_user_id",
    "referred_user_email",
    "referral_code_used",
    "status"
  ]
}
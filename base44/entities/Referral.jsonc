{
  "name": "Referral",
  "type": "object",
  // Clinical patient-referral intake entity. Created and processed by the
  // referral intake workflow (src/pages/ReferralIntake.jsx, ReferralTriage,
  // src/components/referral/*). Earlier revisions of this file mistakenly
  // described an unrelated referral-rewards program; no such program exists in
  // the codebase. The fields below mirror every key the intake/triage code
  // writes, so the Base44 platform persists them instead of silently dropping.
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Server-stamped immutable Agency id from the authenticated creator's exact active AgencyMembership."
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Server-stamped immutable built-in Base44 User id of the referral creator."
    },
    "created_by_user_email_normalized": {
      "type": "string",
      "format": "email",
      "description": "Server-stamped normalized built-in User email paired with created_by_user_id."
    },
    "client_request_id": {
      "type": "string",
      "description": "Caller retry id accepted only by the authorized Referral broker."
    },
    "referral_creation_key": {
      "type": "string",
      "description": "Server-built agency_id:created_by_user_id:client_request_id key used for bounded replay detection. Datastore uniqueness is not assumed."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic server-owned revision used by the Referral broker's conditional updates."
    },
    "patient_name": {
      "type": "string",
      "description": "Patient name as read from the referral document"
    },
    "patient_id": {
      "type": "string",
      "description": "Linked Patient entity id once the referral is matched/admitted"
    },
    "patient_dob": {
      "type": "string",
      "description": "Patient date of birth as read from the referral document"
    },
    "diagnosis": {
      "type": "string",
      "description": "Primary diagnosis read from the referral document (top-level convenience copy of extracted_data.diagnoses.primary_diagnosis)"
    },
    "referral_source": {
      "type": "string",
      "description": "Referring facility, physician, or organization"
    },
    "referral_date": {
      "type": "string",
      "description": "Date the referral was received"
    },
    "estimated_start_date": {
      "type": "string",
      "description": "Estimated start-of-care date"
    },
    "document_type": {
      "type": "string",
      "description": "Source document format (e.g. pdf, fax, image, manual)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Intake priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "processing",
        "awaiting_info",
        "active",
        "declined",
        "ready_for_admission",
        "soc_completed"
      ],
      "default": "new",
      "description": "Intake workflow status. soc_completed = start-of-care visit done (closes the intake→SOC clock)."
    },
    "soc_date": {
      "type": "string",
      "format": "date",
      "description": "Start-of-care date (SOC assessment completed) — closes the referral→SOC timeliness clock"
    },
    "first_visit_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the first in-home visit for this referral"
    },
    "soc_completed_by": {
      "type": "string",
      "description": "Email of the clinician who completed the start of care"
    },
    "document_url": {
      "type": "string",
      "description": "URL of the uploaded referral document"
    },
    "processed_document_url": {
      "type": "string",
      "description": "URL of the generated/processed referral PDF"
    },
    "page_range": {
      "type": "string",
      "description": "Page range within a multi-document PDF this referral was split from"
    },
    "detection_confidence": {
      "type": "number",
      "description": "Confidence of the multi-document split detection"
    },
    "manually_confirmed": {
      "type": "boolean",
      "description": "True once a user manually confirmed the patient match"
    },
    "requires_manual_review": {
      "type": "boolean",
      "description": "True when the automated patient match needs human review"
    },
    "rejection_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the referral was declined"
    },
    "rejected_by": {
      "type": "string",
      "description": "Email of the user who declined the referral"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the nurse the referral is assigned to"
    },
    "match_confidence": {
      "type": "number",
      "description": "Confidence score of the automated patient match"
    },
    "match_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Factors that contributed to the patient match"
    },
    "match_suggestions": {
      "type": "array",
      "description": "Candidate patient matches surfaced for review"
    },
    "match_analysis": {
      "type": "object",
      "description": "Structured output of the patient-match analysis"
    },
    "analysis_results": {
      "type": "object",
      "description": "Structured AI intake-analysis output (priority, care needs, etc.)"
    },
    "missing_information": {
      "type": "array",
      "description": "Items the intake analysis flagged as missing from the referral"
    },
    "discrepancies": {
      "type": "array",
      "description": "Discrepancies found between the referral and matched patient"
    },
    "ai_generated_tasks": {
      "type": "array",
      "description": "Suggested initial tasks extracted from the referral"
    },
    "extracted_data": {
      "type": "object",
      "description": "Structured data extracted from the referral document (demographics, diagnoses, urgency, care needs)"
    },
    "diagnosis_coding": {
      "type": "object",
      "description": "Deterministic PDGM-sequenced diagnosis coding produced by src/components/referral/diagnosisCodeGenerator.js (toPersistedCoding shape: sequenced[], uncoded[], warnings[], scenario, has_acceptable_primary = an RTP-acceptable principal candidate exists, has_pdgm_primary = the sequencer chose a weighted PDGM primary). Codes are only ever harvested verbatim from the referral, never generated. Deliberately TOP-LEVEL (not inside extracted_data) so coding/reimbursement mechanics cannot leak into the referral→admission-note bridges that prompt on extracted_data."
    },
    "follow_up_requests": {
      "type": "object",
      "description": "Provider follow-up plan generated by src/components/referral/referralFollowUpEngine.js (toPersistedFollowUp shape: status open|sent|received|resolved, generated_at, sent_via, fax_log_id, portal_link, counts, items[] with category/severity/needed/why/citation/provider_request/item_status/response, plus received_at, stale_notified_at, and fax_back {incoming_fax_id, document_url, matched_signals}). Drives the ReferralFollowUp page and printable provider information-request form. Automated stale escalation and inbound fax-back matching are intentionally paused until their tenant-authorized brokers are complete. TOP-LEVEL (not inside extracted_data) for the same isolation reason as diagnosis_coding."
    },
    "follow_up_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          }
        }
      },
      "description": "Chronological intake/processing notes"
    }
  },
  // Business fields remain optional because referral intake can start from a
  // document, a linked Patient, or a manual shell. Tenant/identity provenance
  // and the broker revision are mandatory for every newly created row.
  "required": [
    "agency_id",
    "created_by_user_id",
    "created_by_user_email_normalized",
    "client_request_id",
    "referral_creation_key",
    "version"
  ],
  // Referral rows carry PHI and are available only through the reviewed,
  // tenant-authorizing broker. Legacy rows without immutable tenant provenance
  // remain quarantined until an audited backfill proves their Agency.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

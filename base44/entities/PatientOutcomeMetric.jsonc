{
  "name": "PatientOutcomeMetric",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Tenant key copied from the explicitly scoped outcome-measure run. New computeOutcomeMeasures writes and upserts require it; legacy unscoped metrics are never updated or retired by that function."
    },
    "patient_id": {
      "type": "string"
    },
    "episode_start": {
      "type": "string",
      "format": "date"
    },
    "episode_end": {
      "type": "string",
      "format": "date"
    },
    "admission_source": {
      "type": "string",
      "enum": [
        "hospital",
        "community",
        "snf",
        "other"
      ]
    },
    "discharge_disposition": {
      "type": "string",
      "enum": [
        "remained_home",
        "remained_community_with_hha",
        "non_institutional_hospice",
        "moved_out_of_service_area",
        "hospital",
        "snf",
        "deceased",
        "other"
      ],
      "description": "Discharge disposition. The community and hospice values come from OASIS-E2 M2420 codes 1-4. 'hospital' and 'snf' are NOT derivable from M2420 — under the current instrument its codes 2-4 name community and hospice destinations, not facilities — so they can only come from M2410 (Inpatient Facility), which PennSync does not implement. They remain in the enum because rows written before this correction carry them."
    },
    "length_of_service": {
      "type": "number",
      "description": "Days in service"
    },
    "total_visits_provided": {
      "type": "number"
    },
    "readmission_30_day": {
      "type": "boolean"
    },
    "readmission_60_day": {
      "type": "boolean"
    },
    "er_visit_30_day": {
      "type": "boolean"
    },
    "functional_improvement": {
      "type": "object",
      "properties": {
        "ambulation_improved": {
          "type": "boolean"
        },
        "bathing_improved": {
          "type": "boolean"
        },
        "transferring_improved": {
          "type": "boolean"
        },
        "medication_management_improved": {
          "type": "boolean"
        },
        "dyspnea_improved": {
          "type": "boolean"
        },
        "overall_improvement_score": {
          "type": "number"
        }
      }
    },
    "gg_discharge_function_score": {
      "type": "number",
      "description": "Legacy field name retained for stored-data compatibility. It was a PennSync 18-item sum, not the CMS HH QRP Discharge Function measure; current writers do not populate it."
    },
    "internal_gg_18_item_raw_sum": {
      "type": "number",
      "description": "Non-CMS context metric: a simple sum over PennSync's 18 documented GG0130/GG0170 items when at least half are present. It is not the CMS HH QRP Discharge Function measure and never enters improvement-proxy counts."
    },
    "measure_results": {
      "type": "array",
      "description": "Per-measure unadjusted internal proxy results computed by the outcome engine; these are not official CMS results.",
      "items": {
        "type": "object",
        "properties": {
          "measure": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["improved", "not_improved", "excluded"]
          },
          "start_value": {
            "type": "string",
            "description": "Opaque CMS response code at SOC/ROC. Omitted when missing; never numerically coerced."
          },
          "discharge_value": {
            "type": "string",
            "description": "Opaque CMS response code at discharge. Omitted when missing; never numerically coerced."
          },
          "reason": { "type": "string" }
        }
      }
    },
    "input_response_schema_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The response schema id of each episode endpoint (SOC/ROC, Discharge). A record without both endpoints on 'pennsync-oasis-response-v2-cms-e2' was computed from response meanings PennSync cannot vouch for and must be excluded from current internal proxy aggregates."
    },
    "source_assessment_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The OASISAssessment ids this metric was computed from, so a reviewer can re-derive it."
    },
    "instrument_versions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "CMS instrument version at each endpoint."
    },
    "calculation_version": {
      "type": "string",
      "description": "Version of the deterministic outcome core that produced this record. Bumped when the rules change meaning, so stale records can be retired rather than silently re-read under new rules."
    },
    "retired_reason": {
      "type": "string",
      "description": "Why this metric was retired from current internal proxy views — the episode's exclusion reasons at the time it was retired. The row is kept so history stays auditable; it is not deleted."
    },
    "retired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the metric was retired."
    },
    "outcome_measure_source": {
      "type": "string",
      "description": "Provenance of the internal outcome metric. 'oasis_change_score' is a current proxy; retired values include 'retired_unverified_schema', 'retired_ambiguous_duplicate_discharge', 'retired_missing_scoped_patient', and 'retired_duplicate_metric'. Retired rows stay auditable but are excluded from current proxy aggregates."
    },
    "pph_prevention": {
      "type": "object",
      "description": "Within-Stay Potentially Preventable Hospitalization prevention: captured risk, interventions delivered, and the outcome (from the PPH worklist engine)",
      "properties": {
        "risk_score": { "type": "number" },
        "risk_level": { "type": "string" },
        "within_dtc_pac_window": { "type": "boolean" },
        "interventions": { "type": "array", "items": { "type": "string" } },
        "rehospitalized": { "type": "boolean" },
        "measure": { "type": "string" }
      }
    },
    "care_plan_goals_achieved": {
      "type": "number",
      "description": "Number of goals met"
    },
    "care_plan_goals_total": {
      "type": "number"
    },
    "goal_achievement_rate": {
      "type": "number",
      "description": "Percentage"
    },
    "wound_healing_outcome": {
      "type": "string",
      "enum": [
        "healed",
        "improved",
        "stable",
        "deteriorated",
        "n/a"
      ]
    },
    "pain_improvement": {
      "type": "number",
      "description": "Pain level change (admission to discharge)"
    },
    "patient_satisfaction_score": {
      "type": "number",
      "description": "1-5 rating"
    },
    "complications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "adverse_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome_quality_score": {
      "type": "number",
      "description": "Composite quality score 0-100"
    },
    "primary_diagnosis": {
      "type": "string"
    },
    "comorbidities_count": {
      "type": "number"
    }
  },
  "required": [
    "patient_id",
    "episode_start"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

{
  "name": "AgencySettings",
  "type": "object",
  "properties": {
    "office_zip_code": {
      "type": "string",
      "description": "Agency office ZIP code for wage index calculation"
    },
    "wage_index": {
      "type": "number",
      "default": 1.0,
      "description": "CMS wage index for the agency's geographic area"
    },
    "office_name": {
      "type": "string",
      "description": "Agency office name"
    },
    "office_address": {
      "type": "string",
      "description": "Agency office address"
    },
    "avg_staff_hourly_rate": {
      "type": "number",
      "default": 45,
      "description": "Average staff hourly rate for cost calculations"
    },
    "training_cost_per_hour": {
      "type": "number",
      "default": 35,
      "description": "Training cost per hour"
    },
    "documentation_time_per_episode": {
      "type": "number",
      "default": 0.5,
      "description": "Average documentation time per episode in hours"
    },
    "audit_staff_hourly_rate": {
      "type": "number",
      "default": 50,
      "description": "Audit staff hourly rate"
    },
    "avg_episodes_per_year": {
      "type": "number",
      "default": 50,
      "description": "Average similar episodes per year"
    },
    "pennsync_is_system_of_record": {
      "type": "boolean",
      "default": false,
      "description": "Whether PennSync is the agency's complete visit/assessment record. Default false (companion-EMR mode): absence-based compliance alerts in monitorComplianceRisks stay disabled so missing EMR-documented work is never flagged as overdue"
    },
    "is_enterprise": {
      "type": "boolean",
      "default": false,
      "description": "Whether this agency has enterprise features enabled"
    },
    "agency_code": {
      "type": "string",
      "description": "Unique agency code for providers to join"
    },
    "agency_manager_email": {
      "type": "string",
      "description": "Email of the agency manager/admin"
    },
    "ai_learning_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether AI learning is enabled for the agency"
    },
    "agency_wide_learning": {
      "type": "boolean",
      "default": false,
      "description": "Share learned patterns across all providers"
    },
    "custom_compliance_rules": {
      "type": "string",
      "description": "Agency-specific compliance requirements"
    },
    "custom_documentation_style": {
      "type": "string",
      "description": "Preferred documentation style for the agency"
    },
    "ai_model_preference": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "accurate"
      ],
      "default": "balanced",
      "description": "AI model preference"
    },
    "min_confidence_threshold": {
      "type": "number",
      "default": 70,
      "description": "Minimum confidence threshold for AI suggestions"
    },
    "share_learnings_across_providers": {
      "type": "boolean",
      "default": true,
      "description": "Share best practices across providers"
    },
    "agency_specific_prompts": {
      "type": "string",
      "description": "Additional AI instructions specific to agency"
    },
    "auto_apply_best_practices": {
      "type": "boolean",
      "default": false,
      "description": "Auto-apply proven patterns to new notes"
    },
    "custom_terminology": {
      "type": "string",
      "description": "Agency-specific terms or abbreviations"
    },
    "custom_templates_count": {
      "type": "number",
      "default": 0,
      "description": "Number of custom templates created"
    },
    "tcpa_quiet_hours_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether TCPA quiet hours are enforced for outbound texting"
    },
    "tcpa_quiet_start_hour": {
      "type": "number",
      "default": 8,
      "description": "Hour (local) when quiet hours end / texting may begin"
    },
    "tcpa_quiet_end_hour": {
      "type": "number",
      "default": 21,
      "description": "Hour (local) when quiet hours begin / texting must stop"
    },
    "fax_receiving_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether inbound fax receiving is enabled"
    },
    "main_office_number_e164": {
      "type": "string",
      "description": "Main office phone number in E.164 format"
    },
    "office_fax_number_e164": {
      "type": "string",
      "description": "The OFFICE fax machine's number in E.164 format (e.g. +17244650444). This is what recipients see as the sender/reply-to on cover sheets and the fax display name, so replies go straight to the physical office machine — it does not need to be a Telnyx number."
    },
    "outbound_fax_number_e164": {
      "type": "string",
      "description": "The single Telnyx fax-capable number used to TRANSMIT outbound faxes (the technical 'from', attached to the Programmable Fax connection). Presented to recipients under the office fax number's name; the app expects no inbound faxes on it."
    },
    "default_off_duty_template": {
      "type": "string",
      "description": "Default off-duty auto-reply message template"
    },
    "sms_messaging_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether SMS messaging is enabled"
    },
    "sms_quick_replies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick-reply SMS message strings"
    },
    "sms_templates": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Reusable SMS templates"
    },
    "voicemail_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether voicemail is enabled"
    },
    "voicemail_greeting": {
      "type": "string",
      "description": "Voicemail greeting text"
    },
    "allow_international": {
      "type": "boolean",
      "default": false,
      "description": "Whether international calling/texting is allowed"
    },
    "monthly_sms_cap": {
      "type": "number",
      "description": "Monthly SMS cap (positive number, or null for no cap)"
    },
    "business_hours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether business-hours routing is enabled"
    },
    "business_hours_timezone": {
      "type": "string",
      "description": "IANA timezone for business hours"
    },
    "business_hours": {
      "type": "object",
      "description": "Per-day business hours schedule"
    },
    "business_hours_holidays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Holiday date strings excluded from business hours"
    },
    "after_hours_call_action": {
      "type": "string",
      "enum": [
        "transfer",
        "voicemail",
        "hangup"
      ],
      "default": "transfer",
      "description": "Action for after-hours inbound calls"
    },
    "after_hours_transfer_number_e164": {
      "type": "string",
      "description": "After-hours call transfer number in E.164 format"
    },
    "after_hours_call_greeting": {
      "type": "string",
      "description": "After-hours call greeting text"
    },
    "after_hours_sms_auto_reply_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether after-hours SMS auto-reply is enabled"
    },
    "after_hours_sms_auto_reply": {
      "type": "string",
      "description": "After-hours SMS auto-reply message"
    },
    "a2p_10dlc_status": {
      "type": "string",
      "enum": [
        "not_registered",
        "pending",
        "registered"
      ],
      "default": "not_registered",
      "description": "A2P 10DLC registration status"
    },
    "a2p_brand_id": {
      "type": "string",
      "description": "A2P 10DLC brand ID"
    },
    "a2p_campaign_id": {
      "type": "string",
      "description": "A2P 10DLC campaign ID"
    },
    "last_credential_digest_sent_on": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD local/UTC day the personnel credential admin digest was last sent"
    },
    "credential_digest_claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping sendCredentialRenewalReminders digests do not double-send"
    },
    "credential_digest_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When credential_digest_claimed_by was written"
    }
  },
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}
{
  "name": "DocumentSignature",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to PatientDocument"
    },
    "patient_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "consent",
        "hipaa",
        "treatment_agreement",
        "financial_agreement",
        "advance_directive",
        "release",
        "custom_request",
        "other"
      ]
    },
    // Field placements captured in the request builder's step 3 (drag a
    // signature/date/text box onto the page). SignatureRequestCreator already
    // sends these on create, but with no property here Base44 dropped them, so
    // every placement the requester positioned was discarded the moment the
    // request was sent. Persisting them stops that data loss; RENDERING them in
    // the signer portal and stamping them into the output PDF is still to do —
    // until then a request behaves as it does today (whole-document signing).
    "signature_fields": {
      "type": "array",
      "description": "Placed field boxes: position/size are page-relative percentages",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "signerId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["signature", "initials", "date", "text"]
          },
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "size": {
            "type": "object",
            "properties": {
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          }
        }
      }
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signer_name": {
            "type": "string"
          },
          "signer_role": {
            "type": "string",
            "enum": [
              "patient",
              "caregiver",
              "legal_representative",
              "witness",
              "provider"
            ]
          },
          "email": {
            "type": "string"
          },
          "signature_data": {
            "type": "string",
            "description": "Base64 encoded signature image"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "ip_address": {
            "type": "string"
          },
          "device_info": {
            "type": "string"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "drawn",
              "typed",
              "uploaded",
              "biometric"
            ]
          }
        }
      }
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "completed",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "rejected"
      ],
      "default": "pending",
      "description": "Per-record signature status written/read across the e-signature UI (package create, signature submit, trackers). ('signed' is a display-only normalization in signatureUtils.js and is never persisted.)"
    },
    "document_title": {
      "type": "string",
      "description": "Human-readable document title shown in signature lists/cover sheets"
    },
    "document_name": {
      "type": "string",
      "description": "Source document file name"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent signature reminder sent"
    },
    "reminder_claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping signature-reminder crons do not double-send"
    },
    "reminder_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder_claimed_by was written"
    },
    "created_by": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_sent_count": {
      "type": "number",
      "default": 0
    },
    "last_reminder_sent": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_url": {
      "type": "string",
      "description": "Source document URL to be signed"
    },
    "document_content": {
      "type": "string",
      "description": "Inline document content/HTML for the signature request"
    },
    "signed_pdf_url": {
      "type": "string",
      "description": "URL of the generated signed PDF (written on completion)"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the signature package was completed (read across the trackers; the legacy completed_at is unused here)"
    },
    "due_date": {
      "type": "string",
      "description": "When the signature is due"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the signature request expires"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the signature request was sent"
    },
    "reminder_sent": {
      "type": "boolean",
      "description": "Whether a reminder has been sent (boolean flag complementing reminder_sent_count)"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email of the creator (app field; distinct from the Base44 created_by system field)"
    },
    "message": {
      "type": "string",
      "description": "Optional message included with the signature request"
    },
    "required_signatures": {
      "type": "array",
      "description": "Signer specs for the package create flow (parallel to signers[])"
    },
    "signer_name": {
      "type": "string",
      "description": "Legacy single-signer name written by the bulk package create path"
    },
    "signer_email": {
      "type": "string",
      "description": "Legacy single-signer email written by the bulk package create path"
    },
    "signature_hash": {
      "type": "string",
      "description": "Integrity hash of the signed document"
    },
    "signature_hash_alg": {
      "type": "string",
      "description": "Algorithm used for signature_hash"
    },
    "signature_hash_payload_v": {
      "type": "number",
      "description": "Canonical-payload version the integrity MAC was stamped with (v2 adds document_content)"
    },
    "signature_hash_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the integrity hash was computed"
    },
    "archived": {
      "type": "boolean",
      "description": "Whether the signed document has been archived"
    },
    "admin_notified": {
      "type": "boolean",
      "description": "Idempotency flag: admin has been notified of completion"
    },
    "admin_notify_claimed_by": {
      "type": "string",
      "description": "Best-effort claim token shared by notifyAdminOfSignedDocument and onDocumentSigned; re-read before emailing admins"
    },
    "submit_claimed_by": {
      "type": "string",
      "description": "Claim token for submitDocumentSignatures idempotency. Set before rewriting signers/status so concurrent in-person collectors cannot clobber each other's signatures or double-complete."
    },
    "submit_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When submit_claimed_by was written"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "document_type",
    "patient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        }
      ]
    }
  }
}

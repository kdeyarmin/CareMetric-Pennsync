{
  "name": "DocumentSignature",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to PatientDocument"
    },
    "patient_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "consent",
        "hipaa",
        "treatment_agreement",
        "financial_agreement",
        "advance_directive",
        "release",
        "other"
      ]
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signer_name": {
            "type": "string"
          },
          "signer_role": {
            "type": "string",
            "enum": [
              "patient",
              "caregiver",
              "legal_representative",
              "witness",
              "provider"
            ]
          },
          "email": {
            "type": "string"
          },
          "signature_data": {
            "type": "string",
            "description": "Base64 encoded signature image"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "ip_address": {
            "type": "string"
          },
          "device_info": {
            "type": "string"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "drawn",
              "typed",
              "uploaded",
              "biometric"
            ]
          }
        }
      }
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "completed",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "rejected"
      ],
      "default": "pending",
      "description": "Per-record signature status written/read across the e-signature UI (package create, signature submit, trackers). ('signed' is a display-only normalization in signatureUtils.js and is never persisted.)"
    },
    "document_title": {
      "type": "string",
      "description": "Human-readable document title shown in signature lists/cover sheets"
    },
    "document_name": {
      "type": "string",
      "description": "Source document file name"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent signature reminder sent"
    },
    "created_by": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_sent_count": {
      "type": "number",
      "default": 0
    },
    "last_reminder_sent": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_url": {
      "type": "string",
      "description": "Final signed document URL"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "document_type",
    "patient_id"
  ]
}
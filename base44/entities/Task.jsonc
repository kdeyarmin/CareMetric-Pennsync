{
  "name": "Task",
  "type": "object",
  "properties": {
    "client_request_id": {
      "type": "string",
      "description": "Offline idempotency key (queue id) used to dedupe tasks created from the offline sync queue"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity (optional for agency-wide tasks)"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Detailed task description"
    },
    "type": {
      "type": "string",
      "enum": [
        "call",
        "notify",
        "schedule",
        "order",
        "coordinate",
        "document",
        "safety",
        "followup",
        "other"
      ],
      "description": "Type of task"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "Task priority level"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Task status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date for the task"
    },
    "due_time": {
      "type": "string",
      "description": "Due time for the task"
    },
    "due_timeframe": {
      "type": "string",
      "enum": [
        "today",
        "24_hours",
        "48_hours",
        "this_week",
        "next_visit"
      ],
      "description": "Relative timeframe for task completion"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned user"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai_generated",
        "manual",
        "incident",
        "care_plan",
        "recurring"
      ],
      "default": "manual",
      "description": "How the task was created"
    },
    "ai_reason": {
      "type": "string",
      "description": "AI-generated reason for the task"
    },
    "related_visit_id": {
      "type": "string",
      "description": "Reference to Visit entity if task was generated from a visit"
    },
    // Generic source-record link, for tasks generated from something that is not
    // a Visit. ReferralTriage writes these when a referral can't become a chart
    // (missing identity data) so the assignee's task points back at the referral
    // to complete; without the properties Base44 dropped both silently, leaving
    // "complete the referral before admission" with no referral attached.
    // Mirrors the related_entity / related_entity_id pair the backend already
    // writes into Notification.metadata.
    "related_entity": {
      "type": "string",
      "description": "Entity name this task was generated from (e.g. 'Referral')"
    },
    "related_entity_id": {
      "type": "string",
      "description": "Id of the related_entity record"
    },
    "completion_notes": {
      "type": "string",
      "description": "Notes added when task is completed"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a recurring task"
    },
    "recurrence_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "description": "Type of recurrence"
    },
    "recurrence_interval": {
      "type": "number",
      "default": 1,
      "description": "Interval for recurrence (e.g., every 2 weeks)"
    },
    "recurrence_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Days of week for weekly recurrence (Monday, Tuesday, etc.)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "When recurrence should end"
    },
    "parent_task_id": {
      "type": "string",
      "description": "Reference to parent task if this is a recurring instance"
    },
    "last_notification_sent": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last notification sent"
    },
    "notification_preferences": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "notify_before_hours": {
          "type": "number",
          "default": 24
        },
        "notify_on_overdue": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Notification settings for this task"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    }
  },
  "required": [
    "title",
    "priority"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "assigned_to": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "assigned_to": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
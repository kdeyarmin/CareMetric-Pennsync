{
  "name": "AgencyInvoice",
  "type": "object",
  "properties": {
    "agency_code": {
      "type": "string",
      "description": "Agency code this invoice is for"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start date of billing period"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date",
      "description": "End date of billing period"
    },
    "user_count": {
      "type": "number",
      "description": "Number of users during this period"
    },
    "package_name": {
      "type": "string",
      "description": "Name of the feature package"
    },
    "price_per_user": {
      "type": "number",
      "description": "Price per user for this period"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "Detailed line items on the invoice"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal before tax"
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "description": "Tax amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Total invoice amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment was received"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "Stripe invoice ID if paid via Stripe"
    },
    "payment_method": {
      "type": "string",
      "description": "How the invoice was paid"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes on the invoice"
    }
  },
  "required": [
    "agency_code",
    "invoice_number",
    "billing_period_start",
    "billing_period_end",
    "total_amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
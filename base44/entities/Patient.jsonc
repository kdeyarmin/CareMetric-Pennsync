{
  "name": "Patient",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string",
      "description": "Middle name or middle initial"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "medical_record_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "payor": {
      "type": "string",
      "description": "Primary payor or insurance type (e.g., Medicare, Medicaid, Private Insurance)"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Primary emergency contact"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone number"
    },
    "emergency_contact_relationship": {
      "type": "string",
      "description": "Relationship to patient"
    },
    "physician_name": {
      "type": "string",
      "description": "Primary care physician name"
    },
    "physician_phone": {
      "type": "string",
      "description": "Primary care physician phone"
    },
    "physician_email": {
      "type": "string",
      "format": "email",
      "description": "Primary physician email for notifications"
    },
    "caregiver_name": {
      "type": "string",
      "description": "Primary caregiver name"
    },
    "caregiver_email": {
      "type": "string",
      "format": "email",
      "description": "Primary caregiver email"
    },
    "caregiver_phone": {
      "type": "string",
      "description": "Primary caregiver phone"
    },
    "primary_diagnosis": {
      "type": "string"
    },
    "secondary_diagnoses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of secondary diagnoses"
    },
    "chronic_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "date_diagnosed": {
            "type": "string",
            "format": "date"
          },
          "severity": {
            "type": "string",
            "enum": [
              "mild",
              "moderate",
              "severe"
            ]
          },
          "management_notes": {
            "type": "string"
          }
        }
      },
      "description": "List of chronic/long-term conditions"
    },
    "past_surgeries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "procedure": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "surgeon": {
            "type": "string"
          },
          "hospital": {
            "type": "string"
          },
          "complications": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        }
      },
      "description": "Detailed surgical history"
    },
    "family_medical_history": {
      "type": "object",
      "properties": {
        "heart_disease": {
          "type": "boolean"
        },
        "diabetes": {
          "type": "boolean"
        },
        "cancer": {
          "type": "boolean"
        },
        "hypertension": {
          "type": "boolean"
        },
        "stroke": {
          "type": "boolean"
        },
        "alzheimers_dementia": {
          "type": "boolean"
        },
        "mental_illness": {
          "type": "boolean"
        },
        "other_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Family medical history for genetic risk assessment"
    },
    "social_determinants": {
      "type": "object",
      "properties": {
        "housing_stability": {
          "type": "string",
          "enum": [
            "stable",
            "unstable",
            "homeless",
            "temporary"
          ]
        },
        "food_security": {
          "type": "string",
          "enum": [
            "secure",
            "insecure",
            "very_insecure"
          ]
        },
        "financial_strain": {
          "type": "string",
          "enum": [
            "none",
            "mild",
            "moderate",
            "severe"
          ]
        },
        "social_isolation": {
          "type": "string",
          "enum": [
            "well_connected",
            "some_isolation",
            "isolated",
            "severely_isolated"
          ]
        },
        "caregiver_burden": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "severe"
          ]
        },
        "health_literacy": {
          "type": "string",
          "enum": [
            "high",
            "adequate",
            "limited",
            "very_limited"
          ]
        },
        "medication_access": {
          "type": "string",
          "enum": [
            "no_barriers",
            "some_barriers",
            "significant_barriers"
          ]
        },
        "utilities_access": {
          "type": "boolean",
          "description": "Has access to heat, water, electricity"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Social determinants of health affecting care delivery and outcomes"
    },
    "allergies": {
      "type": "string",
      "description": "Known allergies and adverse reactions"
    },
    "current_medications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "prescriber": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Current medication list"
    },
    "past_medical_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Past medical conditions and surgeries"
    },
    "past_hospitalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          },
          "hospital": {
            "type": "string"
          },
          "length_of_stay": {
            "type": "number"
          }
        }
      },
      "description": "History of hospitalizations"
    },
    "baseline_vitals": {
      "type": "object",
      "properties": {
        "blood_pressure_systolic": {
          "type": "number"
        },
        "blood_pressure_diastolic": {
          "type": "number"
        },
        "heart_rate": {
          "type": "number"
        },
        "respiratory_rate": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "oxygen_saturation": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "bmi": {
          "type": "number"
        },
        "pain_level": {
          "type": "number"
        }
      },
      "description": "Baseline vital signs at admission"
    },
    "functional_status": {
      "type": "object",
      "properties": {
        "ambulation": {
          "type": "string",
          "enum": [
            "independent",
            "walker",
            "cane",
            "wheelchair",
            "bedbound"
          ]
        },
        "adl_independence": {
          "type": "string",
          "enum": [
            "independent",
            "minimal_assist",
            "moderate_assist",
            "total_assist"
          ]
        },
        "cognitive_status": {
          "type": "string",
          "enum": [
            "alert_oriented",
            "mild_confusion",
            "moderate_impairment",
            "severe_impairment"
          ]
        },
        "fall_risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Baseline functional assessment"
    },
    "social_history": {
      "type": "object",
      "properties": {
        "living_situation": {
          "type": "string",
          "enum": [
            "alone",
            "with_family",
            "assisted_living",
            "group_home"
          ]
        },
        "primary_language": {
          "type": "string"
        },
        "interpreter_needed": {
          "type": "boolean"
        },
        "smoking_status": {
          "type": "string",
          "enum": [
            "never",
            "former",
            "current"
          ]
        },
        "alcohol_use": {
          "type": "string",
          "enum": [
            "none",
            "occasional",
            "moderate",
            "heavy"
          ]
        },
        "support_system": {
          "type": "string"
        },
        "transportation": {
          "type": "string"
        }
      },
      "description": "Social determinants and history"
    },
    "mental_health": {
      "type": "object",
      "properties": {
        "depression_screening": {
          "type": "string"
        },
        "anxiety_level": {
          "type": "string"
        },
        "psychiatric_history": {
          "type": "string"
        },
        "current_mental_health_treatment": {
          "type": "boolean"
        }
      },
      "description": "Mental health assessment"
    },
    "pain_management": {
      "type": "object",
      "properties": {
        "chronic_pain": {
          "type": "boolean"
        },
        "pain_location": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pain_interventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pain_goals": {
          "type": "string"
        }
      },
      "description": "Pain management plan"
    },
    "wounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "size_length": {
            "type": "number"
          },
          "size_width": {
            "type": "number"
          },
          "size_depth": {
            "type": "number"
          },
          "onset_date": {
            "type": "string",
            "format": "date"
          },
          "treatment_plan": {
            "type": "string"
          }
        }
      },
      "description": "Active wound tracking"
    },
    "advance_directives": {
      "type": "object",
      "properties": {
        "has_living_will": {
          "type": "boolean"
        },
        "has_healthcare_proxy": {
          "type": "boolean"
        },
        "dnr_status": {
          "type": "boolean"
        },
        "proxy_name": {
          "type": "string"
        },
        "proxy_phone": {
          "type": "string"
        },
        "special_instructions": {
          "type": "string"
        }
      },
      "description": "Advance care planning documentation"
    },
    "insurance_primary": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "policy_number": {
          "type": "string"
        },
        "group_number": {
          "type": "string"
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Primary insurance information"
    },
    "insurance_secondary": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "policy_number": {
          "type": "string"
        },
        "group_number": {
          "type": "string"
        }
      },
      "description": "Secondary insurance information"
    },
    "admission_date": {
      "type": "string",
      "format": "date",
      "description": "Date admitted to home health/hospice"
    },
    "discharge_date": {
      "type": "string",
      "format": "date",
      "description": "Date discharged from service"
    },
    "admission_source": {
      "type": "string",
      "enum": [
        "home",
        "hospital",
        "skilled_nursing_facility",
        "rehab",
        "other"
      ],
      "description": "Where patient was admitted from"
    },
    "discharge_disposition": {
      "type": "string",
      "enum": [
        "home",
        "hospital",
        "skilled_nursing_facility",
        "deceased",
        "other"
      ],
      "description": "Where patient was discharged to"
    },
    "care_type": {
      "type": "string",
      "enum": [
        "home_health",
        "hospice"
      ],
      "default": "home_health",
      "description": "Type of care being provided"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discharged",
        "hospitalized",
        "merged",
        "archived"
      ],
      "default": "active"
    },
    "merged_into_id": {
      "type": "string",
      "description": "When this record was merged into another as a duplicate, the surviving Patient id (set by the dedupe/merge flow)"
    },
    "merged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was merged into the surviving patient"
    },
    "merged_by": {
      "type": "string",
      "description": "Email of the user who performed the merge"
    },
    "validation_overrides": {
      "type": "object",
      "description": "Map of field name -> override justification for validation warnings the user acknowledged when saving the patient"
    },
    "clinical_notes": {
      "type": "string",
      "description": "General clinical notes and observations"
    },
    "goals_of_care": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patient and family goals for care"
    },
    "active_alerts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to active PatientAlert entity IDs for quick access to critical alerts"
    },
    "enhanced_notes_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "description": "Unique id stamped by appendPatientNoteHistory; keys the verify-and-retry append"
          },
          "visit_id": {
            "type": "string",
            "description": "Visit this entry documents; re-saves target their entry by this id"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "visit_type": {
            "type": "string"
          },
          "diagnosis": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "compliance_score": {
            "type": "number"
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "enhanced_note": {
            "type": "string"
          },
          "rough_note": {
            "type": "string"
          },
          "quality_score": {
            "type": "number"
          },
          "nurse_email": {
            "type": "string"
          },
          "vital_signs": {
            "type": "object"
          }
        }
      },
      "description": "History of AI-enhanced notes for context building and documentation improvement. Written ONLY via the appendPatientNoteHistory backend function (atomic append) — do not read-modify-write this array from the client."
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "description": "Overall risk score 0-100"
        },
        "level": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "description": "Risk level category"
        },
        "last_calculated": {
          "type": "string",
          "format": "date-time",
          "description": "When risk score was last calculated"
        },
        "confidence": {
          "type": "number",
          "description": "AI confidence in assessment 0-100"
        },
        "category_scores": {
          "type": "object",
          "properties": {
            "clinical_stability": {
              "type": "number"
            },
            "functional_status": {
              "type": "number"
            },
            "safety_risk": {
              "type": "number"
            },
            "readmission_risk": {
              "type": "number"
            },
            "social_factors": {
              "type": "number"
            }
          },
          "description": "Breakdown of risk by category"
        }
      },
      "description": "Comprehensive AI-calculated risk assessment"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample data visible to all users"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this patient record has been soft-archived (e.g. merged duplicate or discharged in a bulk cleanup)"
    },
    "risk_predict_claimed_by": {
      "type": "string",
      "description": "Claim token for predictPatientRisks / predictiveRiskAnalysis idempotency. Set before LLM work and PatientAlert creates so concurrent runs cannot duplicate high-risk alerts."
    },
    "care_plans_gen_claimed_by": {
      "type": "string",
      "description": "Claim token for generateCarePlansFromReferral idempotency. Set before LLM work and CarePlan.create so concurrent runs cannot create duplicate active care plans."
    },
    "care_plan_monitor_claimed_by": {
      "type": "string",
      "description": "Claim token for monitorClinicalDataForCarePlanUpdates idempotency. Set before LLM work and CarePlanProposal/PatientAlert creates so concurrent runs cannot duplicate proposals."
    },
    "compliance_monitor_claimed_by": {
      "type": "string",
      "description": "Claim token for monitorComplianceRisks idempotency. Set before PatientAlert creates so concurrent cron runs cannot duplicate compliance alerts."
    },
    "assigned_nurses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of nurses assigned to this patient"
    },
    "data_completeness_score": {
      "type": "number",
      "description": "Computed 0-100 score of how complete the patient's critical data is"
    },
    "missing_critical_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of critical field names that are missing/empty on this record"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "assigned_nurses": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        },
        {
          "is_sample": true
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_type": "agency_admin"
          }
        },
        {
          "user_condition": {
            "account_type": "super_admin"
          }
        }
      ]
    }
  }
}
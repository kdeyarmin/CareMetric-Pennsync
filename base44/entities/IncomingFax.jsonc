{
  "name": "IncomingFax",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Immutable Agency id proven from the signed provider event and exact service-owned TelecomDestinationBinding. Legacy rows may not carry it and are never auto-routed."
    },
    "ingress_binding_id": {
      "type": "string",
      "description": "Exact TelecomDestinationBinding id that authorized this inbound fax."
    },
    "ingress_binding_key": {
      "type": "string",
      "description": "Canonical binding key retained with the immutable inbound provenance snapshot."
    },
    "ingress_binding_version": {
      "type": "integer",
      "minimum": 1
    },
    "integration_secret_id": {
      "type": "string",
      "description": "Exact active Telnyx IntegrationSecret used to verify and bind the ingress event."
    },
    "received_to_number": {
      "type": "string",
      "description": "Canonical inbound destination proven by TelecomDestinationBinding."
    },
    "user_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_fax_number": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_url": {
      "type": "string",
      "description": "URL to the received fax document"
    },
    "page_count": {
      "type": "number"
    },
    "telnyx_fax_id": {
      "type": "string"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping OCR jobs or signed-webhook forward attempts cannot process/transmit the same fax twice"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ocr_attempts": {
      "type": "number",
      "description": "Count of OCR attempts. A transient OCR failure returns the row to 'pending' (bounded retry) instead of terminally 'failed'; only after the cap is a fax marked failed."
    },
    "ocr_text": {
      "type": "string",
      "description": "Extracted text from OCR"
    },
    "ocr_confidence": {
      "type": "number"
    },
    "ai_summary": {
      "type": "string",
      "description": "Concise AI-generated summary of fax content"
    },
    "ai_category": {
      "type": "string",
      "enum": [
        "lab_results",
        "referral",
        "consultation_note",
        "prescription",
        "insurance_authorization",
        "discharge_summary",
        "imaging_report",
        "progress_note",
        "consent_form",
        "other"
      ]
    },
    "extracted_info": {
      "type": "object",
      "properties": {
        "patient_name": {
          "type": "string"
        },
        "patient_dob": {
          "type": "string"
        },
        "patient_mrn": {
          "type": "string"
        },
        "document_date": {
          "type": "string"
        },
        "provider_name": {
          "type": "string"
        },
        "diagnosis": {
          "type": "string"
        },
        "medications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "urgency_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reasons why this fax is flagged as urgent"
    },
    "suggested_patient_id": {
      "type": "string",
      "description": "AI-suggested patient record to attach this to"
    },
    "suggested_routing": {
      "type": "string",
      "enum": [
        "nurse_review",
        "physician_review",
        "admin",
        "billing",
        "patient_record"
      ],
      "description": "Suggested destination for this fax"
    },
    "confidence_score": {
      "type": "number",
      "description": "AI confidence in analysis 0-100"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "reviewing",
        "routed",
        "archived"
      ],
      "default": "unread"
    },
    "routed_to": {
      "type": "string",
      "description": "User/queue this was routed to"
    },
    "routed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "suggested_referral_id": {
      "type": "string",
      "description": "Tenant-local Referral suggestion for manual review; never treated as an automatic attachment."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Monotonic revision used by the scheduled processor's conditional claim/finalize transitions."
    }
  },
  "required": [
    "agency_id",
    "ingress_binding_id",
    "ingress_binding_key",
    "ingress_binding_version",
    "integration_secret_id",
    "received_to_number",
    "user_email",
    "received_at",
    "document_url",
    "telnyx_fax_id",
    "processing_status",
    "status",
    "version"
  ],
  // Provider webhooks and the scheduled processor use the service role. The
  // PHI-bearing inbox must not be reachable through direct entity CRUD. New
  // tenant-routable rows require the provenance fields above at runtime; old
  // rows remain quarantined instead of being guessed into a tenant.
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

{
  "name": "PatientRiskAssessment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "risk_type": {
      "type": "string",
      "enum": [
        "fall",
        "readmission",
        "infection",
        "deterioration",
        "medication_complication",
        "pressure_injury",
        "dehydration",
        "non_compliance"
      ],
      "description": "Type of risk identified"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "moderate",
        "low"
      ],
      "description": "Predicted risk level"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "AI-calculated risk score (0-100)"
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "evidence": {
            "type": "string"
          }
        }
      },
      "description": "Factors contributing to the risk"
    },
    "intervention_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "intervention": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "evidence_based": {
            "type": "boolean"
          }
        }
      },
      "description": "AI-recommended interventions"
    },
    "clinical_indicators": {
      "type": "object",
      "description": "Specific clinical data points that triggered the prediction"
    },
    "prediction_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this assessment was generated"
    },
    "timeframe": {
      "type": "string",
      "description": "Expected timeframe for risk (e.g., '24-48 hours', '7 days')"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "interventions_applied",
        "risk_resolved",
        "false_positive"
      ],
      "default": "active",
      "description": "Status of this risk alert"
    },
    "acknowledged_by": {
      "type": "string",
      "description": "Email of provider who acknowledged the alert"
    },
    "acknowledged_date": {
      "type": "string",
      "format": "date-time"
    },
    "interventions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which interventions were actually applied"
    },
    "outcome_notes": {
      "type": "string",
      "description": "Notes on what happened with this risk prediction"
    },
    "ai_model_version": {
      "type": "string",
      "description": "Version of AI model used for prediction"
    }
  },
  "required": [
    "patient_id",
    "risk_type",
    "risk_level",
    "risk_score"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}
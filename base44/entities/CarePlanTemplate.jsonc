{
  "name": "CarePlanTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string",
      "description": "Name of the care plan template"
    },
    "diagnosis": {
      "type": "string",
      "description": "Primary diagnosis this template is for"
    },
    "provider_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which provider types can use this template (RN, LPN, NP, etc.)"
    },
    "problem": {
      "type": "string",
      "description": "Pre-defined problem/nursing diagnosis"
    },
    "goal": {
      "type": "string",
      "description": "Pre-defined measurable goal"
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Standard interventions for this condition"
    },
    "baseline_measurements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested baseline measurements to track"
    },
    "frequency_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended assessment frequencies"
    },
    "target_days": {
      "type": "number",
      "default": 60,
      "description": "Default number of days to achieve goal"
    },
    "is_system_template": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a built-in system template"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "template_name",
    "diagnosis",
    "problem",
    "goal",
    "interventions"
  ]
}
{
  "name": "DocumentTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string",
      "description": "Name of the template"
    },
    "name": {
      "type": "string",
      "description": "Template name (written by TemplateManagement form)"
    },
    "description": {
      "type": "string",
      "description": "Brief description of what this template is for"
    },
    "category": {
      "type": "string",
      "enum": [
        "skilled_nursing",
        "physical_therapy",
        "occupational_therapy",
        "speech_therapy",
        "social_work",
        "care_plan",
        "oasis",
        "discharge",
        "admission",
        "consent",
        "assessment",
        "plan",
        "education",
        "other"
      ],
      "description": "Template category"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "admission",
        "routine",
        "recertification",
        "discharge",
        "reassessment",
        "follow_up"
      ],
      "description": "Type of visit this template is for"
    },
    "content": {
      "type": "string",
      "description": "Template content with {{placeholders}}"
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "date",
              "number",
              "select"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "List of available placeholders and their types"
    },
    "required_elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required documentation elements"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for searchability"
    },
    "linked_education_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of linked PatientEducationMaterial resources"
    },
    "related_diagnoses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diagnoses this template is relevant for"
    },
    "is_system_template": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a system-provided template"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether this template is shared publicly with all users"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this template has been used"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this template was AI-generated"
    },
    "generation_prompt": {
      "type": "string",
      "description": "The prompt used to generate this template (if AI-generated)"
    },
    "auto_suggest_materials": {
      "type": "boolean",
      "default": true,
      "description": "Whether to auto-suggest linked education materials"
    }
  },
  "required": [
    "template_name",
    "category",
    "content"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}
{
  "name": "Message",
  "type": "object",
  "description": "Service-owned secure-message record. Only provenance_status=verified_v2 rows with complete immutable tenant, thread, sender, membership, participant, and idempotency bindings are eligible for the dormant v2 brokers. All legacy or incomplete rows are quarantined by those brokers and remain inaccessible through RLS.",
  "properties": {
    "provenance_version": {
      "type": "integer",
      "enum": [2],
      "description": "Static secure-message provenance contract version. Missing or non-v2 rows are quarantined."
    },
    "provenance_status": {
      "type": "string",
      "enum": [
        "verified_v2",
        "quarantined_legacy"
      ],
      "description": "Only verified_v2 is broker-readable. Legacy and ambiguous rows are never upgraded from request claims."
    },
    "agency_id": {
      "type": "string",
      "description": "Immutable Agency id selected through an exact active AgencyMembership and stamped by the server broker."
    },
    "sender_user_id": {
      "type": "string",
      "description": "Immutable built-in Base44 User id derived from auth.me(); never accepted from a caller."
    },
    "sender_membership_id": {
      "type": "string",
      "description": "Exact active AgencyMembership id observed for sender_user_id at creation."
    },
    "sender_membership_version": {
      "type": "integer",
      "minimum": 1,
      "description": "AgencyMembership version observed for the sender at creation. Current membership is revalidated on every broker operation."
    },
    "participant_user_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Sorted immutable set of built-in User ids in the thread, stamped by the server."
    },
    "participant_membership_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "user_email_normalized": { "type": "string", "format": "email" },
          "membership_id": { "type": "string" },
          "membership_version": { "type": "integer", "minimum": 1 },
          "tenant_role": {
            "type": "string",
            "enum": [
              "agency_admin",
              "manager",
              "clinician",
              "office_staff",
              "social_worker",
              "spiritual_care"
            ]
          }
        },
        "required": [
          "user_id",
          "user_email_normalized",
          "membership_id",
          "membership_version",
          "tenant_role"
        ]
      },
      "description": "Immutable, sorted membership snapshot for every thread participant."
    },
    "participant_set_sha256": {
      "type": "string",
      "description": "Server-derived SHA-256 over the immutable agency/thread participant bindings."
    },
    "recipient_user_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Server-derived participant User ids excluding sender_user_id."
    },
    "thread_subject": {
      "type": "string",
      "description": "Immutable normalized subject copied identically to every message in the verified thread."
    },
    "client_request_id": {
      "type": "string",
      "description": "Caller retry id accepted only by the broker and scoped into message_creation_key."
    },
    "message_creation_key": {
      "type": "string",
      "description": "Server-derived thread_id:sender_user_id:client_request_id key. Duplicate rows are quarantined because datastore uniqueness is not assumed."
    },
    "payload_sha256": {
      "type": "string",
      "description": "Server-derived digest binding the idempotency key to normalized immutable content and provenance."
    },
    "read_by_user_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Built-in User ids that acknowledged this message through the broker."
    },
    "state_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic server-owned read-state revision used in updateMany compare-and-set predicates."
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "visit_id": {
      "type": "string",
      "description": "Reference to Visit entity (if applicable)"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to MessageTemplate entity"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "appointment_reminder",
        "follow_up",
        "educational",
        "general"
      ],
      "description": "Type of message"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Patient email address"
    },
    "recipient_phone": {
      "type": "string",
      "description": "Patient phone number for SMS"
    },
    "subject": {
      "type": "string",
      "description": "Email subject or message title"
    },
    "body": {
      "type": "string",
      "description": "Rendered message content"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "description": "How message was delivered"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "failed",
        "bounced",
        "opened"
      ],
      "default": "scheduled",
      "description": "Delivery status"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When email was opened (if tracked)"
    },
    "delivery_error": {
      "type": "string",
      "description": "Error message if delivery failed"
    },
    "personalization_data": {
      "type": "object",
      "description": "Data used for personalizing the message"
    },
    "thread_id": {
      "type": "string",
      "description": "Conversation thread identifier grouping related messages"
    },
    "message_text": {
      "type": "string",
      "description": "Care-team message body text (in-app messaging)"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the message sender"
    },
    "sender_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the message sender"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of recipient email addresses"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Message priority"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attachment URLs"
    },
    "related_event_id": {
      "type": "string",
      "description": "ID of a related entity/event (e.g. referral)"
    },
    "related_event_type": {
      "type": "string",
      "description": "Type of the related entity/event (e.g. 'referral')"
    },
    "is_read": {
      "type": "boolean",
      "description": "Whether the message has been read"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of users who have read the message"
    }
  },
  // Message contains legacy rows without immutable selected-tenant provenance.
  // Keep every direct operation closed until those rows are backfilled or
  // quarantined and a tenant-authorized message broker is proven in hosted tests.
  "required": [],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

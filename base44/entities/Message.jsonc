{
  "name": "Message",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "visit_id": {
      "type": "string",
      "description": "Reference to Visit entity (if applicable)"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to MessageTemplate entity"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "appointment_reminder",
        "follow_up",
        "educational",
        "general"
      ],
      "description": "Type of message"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Patient email address"
    },
    "recipient_phone": {
      "type": "string",
      "description": "Patient phone number for SMS"
    },
    "subject": {
      "type": "string",
      "description": "Email subject or message title"
    },
    "body": {
      "type": "string",
      "description": "Rendered message content"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "description": "How message was delivered"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "failed",
        "bounced",
        "opened"
      ],
      "default": "scheduled",
      "description": "Delivery status"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When email was opened (if tracked)"
    },
    "delivery_error": {
      "type": "string",
      "description": "Error message if delivery failed"
    },
    "personalization_data": {
      "type": "object",
      "description": "Data used for personalizing the message"
    }
  },
  "required": [
    "patient_id",
    "body",
    "delivery_method",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "FaxDraft",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who created the draft"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_fax_number": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "cover_data": {
      "type": "object",
      "description": "Saved cover sheet configuration"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of attached documents"
    },
    "document_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of attached documents"
    },
    "include_cover": {
      "type": "boolean",
      "default": true
    },
    "patient_id": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "User notes about this draft"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "user_email": "{{user.email}}"
    },
    "write": {
      "user_email": "{{user.email}}"
    }
  }
}
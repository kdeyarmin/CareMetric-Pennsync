{
  "name": "SmsMessage",
  "type": "object",
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "Whether the message was sent to or received from the patient"
    },
    "from_number": {
      "type": "string",
      "description": "Sender phone number (E.164)"
    },
    "to_number": {
      "type": "string",
      "description": "Recipient phone number (E.164)"
    },
    "body": {
      "type": "string",
      "description": "Message text"
    },
    "nurse_email": {
      "type": "string",
      "description": "Email of the nurse who owns this conversation thread"
    },
    "patient_id": {
      "type": "string",
      "description": "Associated patient if resolved"
    },
    "thread_id": {
      "type": "string",
      "description": "Conversation thread id (sorted pair of E.164 numbers)"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "received"
      ],
      "default": "queued",
      "description": "Delivery status"
    },
    "client_message_id": {
      "type": "string",
      "description": "Our own idempotency/tracking id (Telnyx has no client idempotency key)"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Telnyx/Twilio message id for tracking"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the nurse has read this message"
    },
    "sent_by": {
      "type": "string",
      "description": "User who sent the message"
    },
    "consent_checked": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient was confirmed opted-in at send time"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for failure if applicable"
    },
    "failure_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the sending nurse was notified of a delivery failure"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of redrive attempts made"
    },
    "last_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last redrive attempt was made"
    },
    "redrive_claimed_by": {
      "type": "string",
      "description": "Per-run token claiming this row for redrive (concurrency guard)"
    },
    "agency_id": {
      "type": "string",
      "description": "Service-stamped Agency id of the TelecomDestinationBinding the message was sent from or received on. Written only by backend functions; never a client claim."
    },
    "destination_binding_id": {
      "type": "string",
      "description": "Service-stamped id of the active TelecomDestinationBinding of the agency line (from_number for outbound, to_number for inbound). redriveFailedSms re-sends only rows carrying it and re-proves the binding at send time."
    },
    "resend_of": {
      "type": "string",
      "description": "Service-stamped id of the failed outbound SmsMessage this text manually re-sends (sendSms resend_of, after proving the caller sent that row)."
    },
    "superseded_by": {
      "type": "string",
      "description": "client_message_id of the manual resend that replaced this failed row. Set only by sendSms; redriveFailedSms never re-sends a superseded row, so a manual Resend and the redrive cannot both text the patient."
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a manual resend superseded this failed row"
    },
    "media": {
      "type": "array",
      "description": "MMS attachments, at most 10 (src/components/messaging/smsMedia.js). Inbound: the webhook records each one 'pending' with Telnyx's media URL and copyInboundSmsMedia copies it into private storage (file_uri) and removes the URL; one that cannot be copied becomes 'unavailable'. Outbound: the https URLs the sender supplied ('sent'), so redriveFailedSms can refuse to re-send an MMS as text only. Written only by backend functions.",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "stored",
              "unavailable",
              "sent"
            ]
          },
          "content_type": {
            "type": "string",
            "description": "Allow-listed MIME type"
          },
          "byte_size": {
            "type": "number"
          },
          "file_uri": {
            "type": "string",
            "description": "Private file URI (UploadPrivateFile). Read only through getSmsMediaUrl, which mints a 60-second signed URL for the row's own nurse."
          },
          "external_url": {
            "type": "string",
            "description": "Inbound: Telnyx's media URL, kept only until the copy is made or abandoned. Outbound: the sender-supplied https URL Telnyx fetched."
          },
          "attempts": {
            "type": "number",
            "description": "Copy attempts made for a pending inbound attachment"
          }
        }
      }
    },
    "media_pending": {
      "type": "boolean",
      "description": "True while an inbound attachment waits for copyInboundSmsMedia (the cron's filter)."
    },
    "media_claimed_by": {
      "type": "string",
      "description": "Per-run token claiming this row for the media copy (concurrency guard)"
    },
    "media_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the media copy claim was taken; a stale claim may be taken over"
    }
  },
  "required": [
    "direction",
    "from_number",
    "to_number"
  ],
  // 2026-10-08 (owner decision): a nurse reads texts addressed to them or sent
  // by them. Every write is a backend function's: marking inbound texts read
  // goes through markSmsRead, so no row field can be edited from a browser
  // (redriveFailedSms re-sends rows, so it must be able to trust them).
  "rls": {
    "read": {
      "$or": [
        {
          "data.nurse_email": "{{user.email}}"
        },
        {
          "data.sent_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}

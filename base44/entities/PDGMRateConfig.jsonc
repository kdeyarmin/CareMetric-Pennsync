{
  "name": "PDGMRateConfig",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Human label for this rate set, e.g. 'CY2025 Official CMS'."
    },
    "effective_year": {
      "type": "string",
      "description": "CMS rate year these numbers apply to, e.g. '2025'."
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "When true, the admin has entered their official CMS numbers, so calculatePDGM treats the result as authoritative rather than an estimate."
    },
    "rates": {
      "type": "object",
      "description": "Editable PDGM rate numbers. Shape mirrors DEFAULT_PDGM_RATES in src/components/pdgm/pdgmRates.js: { basePaymentRate, clinicalGroupWeights, functionalThresholds, functionalMultipliers, comorbidityMultipliers }. Any omitted value falls back to the built-in default, so a partial override is safe."
    },
    "icd10_clinical_groups": {
      "type": "object",
      "description": "Editable ICD-10 (prefix) -> clinical-group map used to assign the PDGM clinical group from the principal diagnosis. Longest matching prefix wins. REPLACE semantics: when non-empty it is used verbatim (supports add/edit/remove); empty/unset falls back to the built-in default map (DEFAULT_ICD10_CLINICAL_GROUPS)."
    },
    "case_mix_weight_table": {
      "type": "object",
      "description": "REFERENCE-ONLY official CMS 432-group case-mix weight table, parsed from the agency's CMS CSV by caseMixWeightsLoader.js (which reports unmappable rows and never guesses). Shape: { payment_year, source, uploaded_at, uploaded_by_email, groups, rows } where rows is the { [caseMixKey]: { weight, hipps?, lupaThreshold? } } map pdgmGrouper.js consumes. Per the pdgmGrouper header this table must NEVER produce a second reimbursement figure: it feeds only the admin-only HIPPS/weight reconciliation preview, payment estimates remain from calculatePDGM, and LUPA thresholds are informational display only (no visit counting, no alerts)."
    },
    "wage_index_table": {
      "type": "object",
      "description": "Agency-imported CBSA wage-index rows for the counties/ZIPs the agency serves, parsed from the year's CMS HH PPS wage index file by wageIndex.js (which validates plausibility and never guesses). Shape: { source, uploaded_at, uploaded_by_email, rows: [{ cbsa, label, wage_index, counties[], zip_prefixes[] }] } — the rate year lives in this config's effective_year, not in the table. The clinical-manager referral brief matches the patient's address to a row and passes that wage index EXPLICITLY to calculatePDGM; an unmatched address falls back to the single AgencySettings.wage_index exactly as before."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes (source of the numbers, who verified them, etc.)."
    },
    "updated_by_email": {
      "type": "string",
      "description": "Email of the admin who last saved these rates."
    },
    "agency_name": {
      "type": "string",
      "description": "Tenant agency this rate set belongs to. savePDGMRateConfig filters/updates by this so multi-tenant admins cannot clobber another agency's rates."
    }
  },
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  },
  "required": []
}
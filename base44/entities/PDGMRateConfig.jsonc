{
  "name": "PDGMRateConfig",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Human label for this retired reference rate set. A label never makes the values official or payment-eligible."
    },
    "effective_year": {
      "type": "string",
      "description": "CMS rate year these numbers apply to, e.g. '2025'."
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "Deprecated legacy marker retained for data compatibility only. It is ignored for calculation and must remain false; no stored flag can authenticate or enable PDGM payment output."
    },
    "rates": {
      "type": "object",
      "description": "Retired factorized reference values retained for data compatibility. Shape mirrors DEFAULT_PDGM_RATES in src/components/pdgm/pdgmRates.js. These values and partial overrides are not CMS HHGS inputs and cannot produce payment output."
    },
    "icd10_clinical_groups": {
      "type": "object",
      "description": "Retired illustrative ICD-10 prefix map retained for data compatibility. It is not the CMS HHGS diagnosis logic and cannot produce a billable clinical-group assignment."
    },
    "case_mix_weight_table": {
      "type": "object",
      "description": "REFERENCE-ONLY CMS 432-group case-mix table parsed by caseMixWeightsLoader.js. It cannot select a group or produce money without complete date-effective HHGS logic. The legacy calculatePDGM approximation is retired; LUPA thresholds are informational only and are not wired to visit counting."
    },
    "wage_index_table": {
      "type": "object",
      "description": "Agency-imported CBSA wage-index rows for the counties/ZIPs the agency serves, parsed from the year's CMS HH PPS wage index file by wageIndex.js (which validates plausibility and never guesses). Shape: { source, uploaded_at, uploaded_by_email, rows: [{ cbsa, label, wage_index, counties[], zip_prefixes[] }] } — the rate year lives in this config's effective_year, not in the table. The clinical-manager referral brief matches the patient's address to a row and passes that wage index EXPLICITLY to calculatePDGM; an unmatched address falls back to the single AgencySettings.wage_index exactly as before."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes (source of the numbers, who verified them, etc.)."
    },
    "updated_by_email": {
      "type": "string",
      "description": "Email of the admin who last saved these rates."
    },
    "agency_name": {
      "type": "string",
      "description": "Tenant agency this rate set belongs to. savePDGMRateConfig filters/updates by this so multi-tenant admins cannot clobber another agency's rates."
    }
  },
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  },
  "required": []
}

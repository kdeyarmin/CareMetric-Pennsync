{
  "name": "MicroLearningProgress",
  "type": "object",
  "properties": {
    "nurse_email": {
      "type": "string",
      "description": "Email of the nurse"
    },
    "skill_gap_id": {
      "type": "string",
      "description": "Identifier for the skill gap being addressed"
    },
    "skill_area": {
      "type": "string",
      "description": "Name of the skill area"
    },
    "module_type": {
      "type": "string",
      "enum": [
        "micro_lesson",
        "quiz",
        "scenario",
        "practice_exercise"
      ],
      "description": "Type of learning module"
    },
    "content": {
      "type": "object",
      "description": "The AI-generated learning content"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "needs_review"
      ],
      "default": "not_started"
    },
    "score": {
      "type": "number",
      "description": "Score achieved (0-100)"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of attempts"
    },
    "time_spent_minutes": {
      "type": "number",
      "default": 0,
      "description": "Total time spent on this module"
    },
    "notes": {
      "type": "string",
      "description": "User notes or reflections"
    },
    "source": {
      "type": "string",
      "enum": [
        "note_review",
        "compliance_check",
        "manual",
        "ai_recommendation"
      ],
      "description": "How this learning was triggered"
    },
    "related_patient_id": {
      "type": "string",
      "description": "Patient ID if triggered from specific documentation"
    }
  },
  "required": [
    "nurse_email",
    "skill_area",
    "module_type",
    "status"
  ],
  // This is a training ATTESTATION record — it evidences that a nurse completed
  // remediation — but it had no policy at all, so any authenticated user could
  // write a row under someone else's nurse_email. Scoping writes to the owner
  // (plus admin) is the rule docs/RLS-REMEDIATION-SPEC-2026-06-19.md §C calls
  // workable in-repo, and it breaks nothing: every client write site
  // (AIComplianceQuizGenerator, InteractiveDocumentationScenarios,
  // NurseTrainingHub, LearnerMemoryBoosters) already sets nurse_email to the
  // signed-in user.
  //
  // Read is deliberately left open, per that same spec note: manager and
  // staff-overview screens read across nurses, and owner-scoping reads would
  // need each of those confirmed admin-gated first (checklist §7).
  "rls": {
    "write": {
      "$or": [
        {
          "nurse_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
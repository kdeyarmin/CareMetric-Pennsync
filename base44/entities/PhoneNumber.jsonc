{
  "name": "PhoneNumber",
  "type": "object",
  "properties": {
    "e164": {
      "type": "string",
      "description": "The Twilio virtual number in E.164 form, e.g. +12155550100. Unique across the pool."
    },
    "label": {
      "type": "string",
      "description": "Optional friendly label for the number (e.g. 'Nurse line 1', 'Intake')."
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "assigned"
      ],
      "default": "available",
      "description": "Whether the number is unassigned (available) or currently assigned to a nurse."
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Email of the user this number is currently assigned to as their work number (when status is 'assigned')."
    },
    "twilio_phone_number_sid": {
      "type": "string",
      "description": "Twilio IncomingPhoneNumber SID (PN\u2026) for this number, used for provisioning/config."
    },
    "notes": {
      "type": "string",
      "description": "Optional admin notes about the number."
    }
  },
  "required": [
    "e164"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
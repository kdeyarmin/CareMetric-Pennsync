{
  "name": "FaxFolder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "folder_name": {
      "type": "string",
      "description": "Name of the folder"
    },
    "color": {
      "type": "string",
      "enum": [
        "blue",
        "green",
        "purple",
        "red",
        "orange",
        "yellow"
      ],
      "default": "blue"
    },
    "icon": {
      "type": "string",
      "description": "Icon name for display"
    },
    "parent_folder_id": {
      "type": "string",
      "description": "For nested folders"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "folder_name"
  ],
  "rls": {
    "read": {
      "user_email": "{{user.email}}"
    },
    "write": {
      "user_email": "{{user.email}}"
    }
  }
}
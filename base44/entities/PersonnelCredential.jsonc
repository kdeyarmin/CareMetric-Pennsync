{
  "name": "PersonnelCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Employee email"
    },
    "user_name": {
      "type": "string",
      "description": "Employee full name"
    },
    "agency_name": {
      "type": "string",
      "description": "Employee agency or business name"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "license",
        "certification",
        "insurance"
      ],
      "description": "Type of personnel file item"
    },
    "title": {
      "type": "string",
      "description": "Name of license, certification, or insurance item"
    },
    "issuing_organization": {
      "type": "string",
      "description": "Issuing board, carrier, or certifying body"
    },
    "credential_number": {
      "type": "string",
      "description": "License, certificate, or policy number"
    },
    "issued_date": {
      "type": "string",
      "format": "date",
      "description": "Issue or effective date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date"
    },
    "uploaded_file_url": {
      "type": "string",
      "description": "Current uploaded document URL"
    },
    "uploaded_file_name": {
      "type": "string",
      "description": "Display name of uploaded document"
    },
    "notes": {
      "type": "string",
      "description": "Employee notes about this item"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending_approval",
      "description": "Approval and expiration status"
    },
    "approved_by": {
      "type": "string",
      "description": "Approving admin email"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Approval timestamp"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason the uploaded document was rejected"
    },
    "reminder_offsets_sent": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Reminder offsets already sent by sendPersonnelExpirationNotifications"
    },
    "renewal_email_offsets_sent": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Reminder offsets already sent by sendCredentialRenewalReminders (own marker so it doesn't collide with the other credential-reminder crons)"
    },
    "expiration_note_offsets_sent": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Reminder offsets already sent by sendExpirationNotifications (own marker so it doesn't collide with the other credential-reminder crons)"
    },
    "expiration_note_claimed_by": {
      "type": "string",
      "description": "Per-run claim token for sendExpirationNotifications before creating in-app notes"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent reminder timestamp"
    },
    "reminder_claimed_by": {
      "type": "string",
      "description": "Per-run claim token so overlapping credential-reminder crons do not double-send"
    },
    "reminder_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder_claimed_by was written"
    },
    "renewal_email_claimed_by": {
      "type": "string",
      "description": "Per-run claim token for sendCredentialRenewalReminders (separate from reminder_claimed_by used by sendPersonnelExpirationNotifications)"
    },
    "renewal_email_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When renewal_email_claimed_by was written"
    }
  },
  "required": [
    "user_id",
    "title",
    "item_type",
    "expiration_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    // Write is ADMIN-ONLY. RLS cannot restrict a single field, so owner write
    // access let staff set status='approved' on their own credential. Staff
    // create/update goes through submitPersonnelCredential (pins
    // status=pending_approval); approve/reject goes through the admin-gated
    // reviewPersonnelCredential.
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ScheduledFax",
  "type": "object",
  "description": "Server-owned queue for authority-bound private-document fax batches. Legacy URL/from-number rows remain readable to service workers only and are rejected at dispatch when versioned provenance is absent.",
  "properties": {
    "queue_creation_reservation_token": {
      "type": "string",
      "description": "Opaque owner of the Agency creation reservation, retained to release only that owner after an uncertain create is recovered."
    },
    "schedule_key": {
      "type": "string",
      "description": "SHA-256 idempotency key scoped to Agency, immutable authorizing User id, and client_request_id. Runtime still detects duplicates because datastore uniqueness is not assumed."
    },
    "client_request_id": {
      "type": "string",
      "description": "Bounded caller retry identity used only inside the server-built schedule_key."
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the service-owned scheduled-fax authority contract. Only version 1 is dispatchable."
    },
    "agency_id": {
      "type": "string",
      "description": "Immutable Agency id proven by the authenticated scheduling broker."
    },
    "document_id": {
      "type": "string",
      "description": "Private Document identity proven through DocumentTenantBinding."
    },
    "document_binding_id": {
      "type": "string",
      "description": "Exact immutable DocumentTenantBinding observed when the schedule was authorized."
    },
    "document_binding_version": {
      "type": "integer",
      "minimum": 2,
      "description": "DocumentTenantBinding format version observed when the schedule was authorized."
    },
    "document_content_sha256": {
      "type": "string",
      "description": "Exact private-document content digest observed when the schedule was authorized."
    },
    "provider": {
      "type": "string",
      "enum": [
        "telnyx"
      ]
    },
    "integration_secret_id": {
      "type": "string"
    },
    "integration_secret_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "fax_connection_id": {
      "type": "string"
    },
    "sender_number_e164": {
      "type": "string",
      "description": "Exact server-resolved outbound sender; caller-supplied from_number is never used."
    },
    "sender_telecom_binding_id": {
      "type": "string"
    },
    "sender_telecom_binding_version": {
      "type": "integer",
      "minimum": 1
    },
    "sender_provider_number_id": {
      "type": "string"
    },
    "sender_settings_id": {
      "type": "string"
    },
    "sender_settings_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorized_by_user_id": {
      "type": "string",
      "description": "Immutable built-in User id that authorized the scheduled disclosure."
    },
    "authorized_by_email_normalized": {
      "type": "string",
      "format": "email",
      "description": "Normalized built-in email retained as an integrity check for authorized_by_user_id."
    },
    "authorized_by_membership_id": {
      "type": "string",
      "description": "Exact active AgencyMembership that authorized the scheduled disclosure."
    },
    "authorized_by_membership_version": {
      "type": "integer",
      "minimum": 1,
      "description": "AgencyMembership revision that authorized the scheduled disclosure."
    },
    "authorized_tenant_role": {
      "type": "string",
      "enum": [
        "agency_admin",
        "manager",
        "clinician",
        "office_staff",
        "social_worker",
        "spiritual_care"
      ],
      "description": "Tenant role re-proved at dispatch; a changed role fails closed."
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time",
      "description": "When to send the fax"
    },
    "from_number": {
      "type": "string",
      "description": "Legacy caller-supplied sender value. Versioned jobs ignore it and resolve the agency fax line server-side."
    },
    "to_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "document_url": {
      "type": "string",
      "description": "Legacy public/signed URL. Versioned jobs must omit it and create a short-lived private-file capability only at dispatch."
    },
    "document_name": {
      "type": "string"
    },
    "cover_page_details": {
      "type": "object"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "normal",
        "low"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "deferred",
        "processing",
        "sent",
        "partial_failure",
        "needs_review",
        "blocked",
        "cancelled",
        "failed"
      ],
      "default": "pending"
    },
    "patient_id": {
      "type": "string"
    },
    "claimed_by": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatch_submission_state": {
      "type": "string",
      "enum": ["ready", "started"],
      "description": "One-shot queue provider submission fence. Initialized ready by the scheduling producer. Only a verified preparation failure with no uncertain recipients may restore ready for the remaining recipients; queue claims never reset it."
    },
    "dispatch_attempt_id": {
      "type": "string",
      "description": "Opaque identity for the current processor-to-broker dispatch attempt."
    },
    "dispatch_retry_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of verified pre-dispatch configuration failures. It never counts an ambiguous or provider-started attempt."
    },
    "next_dispatch_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest time a deferred row may be claimed after a verified pre-dispatch failure."
    },
    "last_dispatch_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the queue last acquired a dispatch claim, independent of provider acceptance."
    },
    "accepted_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "unknown_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "last_error_code": {
      "type": "string",
      "description": "Bounded non-PHI machine code explaining a blocked or review-required queue outcome."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scheduled fax was canceled (survives claim races; claim must not clear this)"
    },
    "canceled_by": {
      "type": "string",
      "description": "Email of the user who canceled the scheduled fax"
    }
  },
  "required": [
    "scheduled_time",
    "to_numbers"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}

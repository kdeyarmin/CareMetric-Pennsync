{
  "name": "NoteFeedback",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "RN",
        "LPN",
        "NP",
        "MD",
        "DO",
        "PT",
        "OT",
        "ST",
        "MSW",
        "Chiropractor"
      ],
      "description": "Provider type that generated/reviewed the note"
    },
    "visit_type": {
      "type": "string",
      "description": "Type of visit documented"
    },
    "diagnosis": {
      "type": "string",
      "description": "Patient diagnosis for this note"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "too_generic",
        "missed_elements",
        "inaccurate",
        "good_coverage",
        "excellent",
        "incomplete",
        "too_verbose",
        "other"
      ],
      "description": "Type of feedback provided"
    },
    "feedback_text": {
      "type": "string",
      "description": "Detailed feedback comments from user"
    },
    "missed_elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific elements that were missing from the note"
    },
    "inaccurate_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        }
      },
      "description": "Sections that were inaccurate with details"
    },
    "generated_note": {
      "type": "string",
      "description": "The full generated note that was reviewed"
    },
    "rough_note": {
      "type": "string",
      "description": "The original transcription/rough note"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "User's quality rating of the note (1-5 stars)"
    },
    "would_use_again": {
      "type": "boolean",
      "description": "Whether user would use this for future similar notes"
    },
    "improvement_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggestions for improving note generation"
    },
    "strong_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the system did well"
    }
  },
  "required": [
    "feedback_type",
    "feedback_text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
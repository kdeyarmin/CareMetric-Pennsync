<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PennSync</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  Camera / microphone usage strings.
	  These are surfaced by iOS the first time the WKWebView requests
	  getUserMedia (telehealth video visits, visit audio recording /
	  Whisper transcription) or the camera-fax document scanner.
	  App Store review rejects binaries that access these APIs without
	  a purpose string, so keep them specific to the clinical features.
	-->
	<key>NSCameraUsageDescription</key>
	<string>PennSync uses the camera for telehealth video visits, scanning documents with Camera Fax, and capturing incident or wound photos for the patient chart.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PennSync uses the microphone for telehealth video visits and to record visit audio for SmartNote clinical documentation and transcription.</string>
	<!--
	  The dictation buttons (SmartNote DictationButton, the visit Real-Time
	  Dictation Scribe) use the Web Speech API. WebKit backs it with Apple's
	  speech recognizer and checks for this key itself: an app without it has
	  every recognition request denied, so dictation silently never starts.
	-->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PennSync uses speech recognition so you can dictate visit notes and clinical documentation instead of typing them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PennSync accesses your photo library so you can attach existing photos of documents, wounds, or incidents to the patient chart and Camera Fax.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PennSync saves captured document scans and exported files to your photo library when you choose to keep a copy on this device.</string>

	<!-- Uses only Apple's system TLS/HTTPS; no proprietary encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  App-Bound Domains used by WebViewController's main-frame navigation
	  containment. The current frontend intentionally registers no service
	  worker and provides no offline app shell. Bare domains cover their
	  subdomains, so caremetricai.com covers app.caremetricai.com (the origin
	  WebViewController loads) and base44.app covers caremetricai.base44.app and
	  the Base44 auth/API endpoints.

	  All THREE are listed on purpose and this is the transitional set. The list
	  takes up to ten entries, so one binary can work either side of the hosting
	  move: caremetricai.com is where the app now loads, and the two Base44
	  domains stay because sign-in is still Base44's — `/login` on the app origin
	  is a Base44-served page today, and its flow can navigate the main frame to
	  a base44.app address. Dropping either Base44 entry before the backend exit
	  completes breaks sign-in on this binary. Dropping them AFTER it is a
	  separate, reviewed release.
	-->
	<key>WKAppBoundDomains</key>
	<array>
		<string>caremetricai.com</string>
		<string>base44.app</string>
		<string>base44.com</string>
	</array>

	<!--
	  Schemes queried via UIApplication.canOpenURL before handing links to
	  iOS (openExternally in WebViewController). iOS 9+ requires them to be
	  declared here or canOpenURL always returns false.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>http</string>
		<string>https</string>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!--
	  PennSync ships ONE light theme (see the comment on the dark-class effect
	  in src/components/Layout.jsx). Without this key a dark-mode device does two
	  things to the shell: the status bar draws WHITE text over the page's white
	  header (the page is drawn under it — contentInsetAdjustmentBehavior is
	  .never), and WKWebView reports `prefers-color-scheme: dark`, which the
	  pre-sign-in screens partially honour — measured 2026-10-08 on the live
	  sign-in page, the "Welcome to PennSync" heading renders near-white on a
	  light gradient. Pinning the app to Light fixes both, for whatever frontend
	  build the origin happens to serve.
	-->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

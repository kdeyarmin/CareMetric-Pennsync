# ---------------------------------------------------------------------------
# Backend selection
#
# Omitted or "base44" keeps the existing production path. "independent-staging"
# builds the same app against Supabase Auth and the owned authority store; it
# is synthetic staging only and fails closed before a Base44 client can be
# constructed if any value below is missing or invalid. There is no fallback
# between the two. See docs/INDEPENDENT_STAGING_APP.md.
# ---------------------------------------------------------------------------
VITE_PENNSYNC_BACKEND=base44

# Required only when VITE_PENNSYNC_BACKEND=independent-staging.
# The reference and URL must be one of the two reviewed pairs exactly:
#   local-pennsync-authority + http://127.0.0.1:54321
#   xxtyweswohkvgkprimwa     + https://xxtyweswohkvgkprimwa.supabase.co
VITE_PENNSYNC_STAGING_PROJECT_REF=
VITE_PENNSYNC_STAGING_PROJECT_URL=
# Modern publishable key only. Never a secret or service-role key.
VITE_PENNSYNC_STAGING_PUBLISHABLE_KEY=
# JSON object mapping each of the four approved test aliases to its
# independently provisioned native Auth UUID. Public identifiers, not secrets.
VITE_PENNSYNC_STAGING_ACTORS=
# Optional, and the only way a ported handler becomes reachable from the app.
# Unset, every ported name falls through to the same refusal any unsupported
# name gets, so leaving it empty changes nothing. Must be one of two exactly:
#   https://pennsync-api-production.up.railway.app
#   http://127.0.0.1:54341
# The caller's own bearer goes to this origin, so it is pinned rather than
# shaped — and the publishable key above is never sent to it.
#
# NOT READY TO SET YET. The ported service requires an `agency_id` its Base44
# original did not, and no existing call site sends one — `ReferralIntake.jsx`,
# `src/functions/listPolicyLibrary.js`, `UserGuides.jsx` and `Help.jsx` all
# invoke without a tenant. Setting this today makes those flows refuse with
# STAGING_TENANT_SELECTION_REQUIRED rather than work. Migrating each call site
# is a reviewed change per site, tracked in the transition plan.
VITE_PENNSYNC_API_URL=

# Base44 frontend runtime configuration (required on the base44 path)
VITE_BASE44_APP_ID=your-app-id
VITE_BASE44_BACKEND_URL=https://your-base44-backend.example.com

# Frontend owner identity (UI gating only). Super-admin UI requires BOTH this
# email and Base44's protected role=admin. Keep it aligned with the backend
# SUPER_ADMIN_EMAIL setting below. Missing configuration fails closed.
VITE_SUPER_ADMIN_EMAIL=

# First-party CareMetric Support Hub rollout. The production CareMetric Base44
# app is enabled only when its immutable app ID matches and VITE_DEPLOY_ENV is
# exactly "production". An omitted flag enables that verified production build;
# an explicit value other than the exact string "true" disables it. Preview/dev,
# staging and every other app ID stay off; /Help remains the fallback.
# VITE_APP_VERSION must be version-shaped (for example, 3.8.2).
VITE_CENTRAL_HELP_ENABLED=false
VITE_DEPLOY_ENV=development
VITE_APP_VERSION=

# Build-time compatibility toggle
# Set to true only if legacy Base44 SDK imports are still used.
BASE44_LEGACY_SDK_IMPORTS=false

# ---------------------------------------------------------------------------
# Backend secrets (Deno function secrets — never VITE_*)
#
# These are the ONLY backend env vars the app reads. Everything else that
# used to be env-configured now lives in-app (Telnyx credentials + numbers in
# Administration -> Super Admin, stored on IntegrationSecret / AgencySettings)
# or is hardcoded (logo, storage-host allowlist, store links).
# ---------------------------------------------------------------------------

# Security (set at launch)
SUPER_ADMIN_EMAIL=             # Exact platform-owner email for privileged backend
                               #   operations. Requires protected role=admin too;
                               #   missing configuration fails closed.
SIGNATURE_HMAC_SECRET=         # HMAC secret that signs/verifies e-signature integrity
                               #   tokens (signatureIntegrity). Use a long random value;
                               #   missing or short configuration fails closed.
INTERNAL_FN_SECRET=            # Shared secret for scheduled/internal functions (the cron
                               #   family: fax/SMS queues, reminders, outcome measures, …).
                               #   Platform triggers must POST with header
                               #   x-internal-secret: <INTERNAL_FN_SECRET>; unattended runs
                               #   FAIL CLOSED (500) while it is unset. See
                               #   docs/LEARNING_CENTER_SCHEDULED_JOBS.md.

# Required public application origin
APP_PUBLIC_URL=                # Exact HTTPS origin used in outbound app links (for example,
                               #   https://staging.example.base44.app). No APP_URL or production
                               #   fallback exists; missing/malformed configuration fails closed.

# Optional behavior override
CARE_PLAN_MONITOR_MIN_CONFIDENCE= # Confidence floor (0-100, default 60) below which the
                               #   care-plan monitor skips auto-creating review proposals.

# Explicit release gate (leave unset/blank until its hosted approval is complete)
OUTBOUND_DELIVERY_RELEASE=     # General email/SMS/fax/voice gate. Unset or blank
                                #   is safely paused; only the exact value enabled-v1 releases
                                #   delivery after a separate environment-specific approval.
                                #   Authorized manual account invitations are independent.
OUTBOUND_FAX_WORKFLOW_RELEASE= # Exact enabled-v1 permits scheduled/retry fax queues and
                                # schedule creation without releasing general email/SMS/voice.
OUTCOME_PIPELINE_RELEASE=       # Only the exact value enabled-v1 releases the outcome
                                #   workflow. This is not a global outbound-delivery gate.
WORKFLOW_RELEASE_AUTO_RETRY_FAILED_FAXES=
WORKFLOW_RELEASE_CHECK_STALE_FOLLOW_UP_REQUESTS=
WORKFLOW_RELEASE_POLL_FAX_STATUSES=
WORKFLOW_RELEASE_PROCESS_INBOUND_FAXES=
WORKFLOW_RELEASE_PROCESS_SCHEDULED_FAXES=
                                # Each workflow above is fail-closed unless its own value
                                #   is exactly enabled-v1. Keep blank in staging until the
                                #   corresponding hosted proof and release approval exist.

# Direct-provider feature keys. Most application AI uses Base44 Core.InvokeLLM
# and email uses Base44 Core.SendEmail; neither consumes a separate app secret.
# Missing keys below disable only the named optional capability.
OPENAI_API_KEY=                # Direct Whisper/audio transcription, including the
                               #   transcription step of SOAP-note-from-audio.
ANTHROPIC_API_KEY=             # Direct SOAP-note-from-audio structuring only. Fax-cover
                               #   formatting is deterministic and requires no provider key.
HEYGEN_API_KEY=                # Legacy only. Retire after verified central learning cutover; do not provision for the Hub runtime.
CENTRAL_LEARNING_RELEASE=      # Backend release control: hub-runtime-v1 retires the primary local course/video generation endpoints.
VITE_CENTRAL_LEARNING_ENABLED= # Frontend cutover: true only after Hub delivery and legacy record migration are verified.

# Hosted backend only: central administrator reads remain disabled by default.
# See docs/CENTRAL_ADMIN_ADAPTER.md. Never prefix these with VITE_.
CAREMETRIC_ADMIN_ENABLED=false
HUB_SUPABASE_PUBLISHABLE_KEY=
CAREMETRIC_ADMIN_IDENTITY_MAP_JSON=
CAREMETRIC_ADMIN_SOURCE_REVISION=

# ---------------------------------------------------------------------------
# Railway service settings (server-side, never VITE_*)
#
# These belong in each Railway service's own variables, not in this file and
# not in a browser bundle. They are listed here so the full configuration
# surface is documented in one place. Every control defaults closed.
# ---------------------------------------------------------------------------

# services/integration-runtime — external AI, email and private files.
# Deployed and paused. See services/integration-runtime/README.md.
INTEGRATIONS_RELEASE=              # Exactly enabled-v1 releases the service
INTEGRATIONS_ALLOWED_OPERATIONS=   # Comma-separated released operations
INTEGRATIONS_BROWSER_RELEASE=      # Exactly enabled-v2 releases the browser route
INTEGRATIONS_BROWSER_OPERATIONS=   # Subset of INTEGRATIONS_ALLOWED_OPERATIONS
INTEGRATIONS_AUTHORITY_MODE=       # base44 (default) or independent
INTEGRATIONS_APP_ID=               # Required for independent, and must name the app
                                   #   the target store was pinned to. The store's
                                   #   pin defaults to staging and this defaults to
                                   #   production, so leaving it unset in independent
                                   #   mode is refused at startup rather than
                                   #   reporting ready and failing every call.
INTEGRATIONS_AUTHORITY_URL=        # Required for independent: a reviewed authority target
INTEGRATIONS_AUTHORITY_PUBLISHABLE_KEY=
                                   # Required for independent. Publishable key
                                   #   only; a secret/service-role key is refused
                                   #   at startup because it would read past the
                                   #   caller's own authority.

# Operator-run provisioning of a new authority store. Not read by any service.
PENNSYNC_PROVISION_DATABASE_URL=   # Target database; never committed
PENNSYNC_PROVISION_APP_ID=         # The app this deployment will serve, pinned once

# services/pennsync-api — handlers ported out of Base44.
# Source only; not deployed. See services/pennsync-api/README.md.
PENNSYNC_API_RELEASE=              # Exactly enabled-v1 releases the service
PENNSYNC_API_APP_ID=               # Required once released, and must name the app
                                   #   the target store was pinned to (see
                                   #   INTEGRATIONS_APP_ID above for why)
PENNSYNC_API_FUNCTIONS=            # Comma-separated released handler names
PENNSYNC_API_AUTHORITY_URL=
PENNSYNC_API_AUTHORITY_PUBLISHABLE_KEY=
PENNSYNC_API_ALLOWED_ORIGINS=      # Optional HTTPS origin allowlist
PENNSYNC_API_DOCUMENT_LOGO=        # Optional inline data:image/png;base64 logo for ported documents
PENNSYNC_API_INTEGRATIONS_URL=     # The integration runtime's origin, for handlers that
                                   #   call a brokered Core integration. One of a fixed
                                   #   pair of origins; any other value is refused at
                                   #   startup, because this is where the caller's own
                                   #   bearer is sent. Unset means such a handler refuses
                                   #   before it reaches the network.

# Browser transport to the external runtime (build-time, nonsecret).
# Default off; see docs/EXTERNAL_INTEGRATION_BROWSER_TRANSPORT.md.
VITE_EXTERNAL_INTEGRATIONS=disabled
VITE_EXTERNAL_INTEGRATION_ORIGIN=
VITE_EXTERNAL_INTEGRATION_OPERATIONS=
VITE_EXTERNAL_INTEGRATION_REVISION=

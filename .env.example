# Base44 frontend runtime configuration (required)
VITE_BASE44_APP_ID=your-app-id
VITE_BASE44_BACKEND_URL=https://your-base44-backend.example.com

# Platform owner / super-admin identity (opt-in email override)
# Designates an account treated as super admin BY EMAIL, in addition to anyone
# with account_type === 'super_admin'. The frontend reads VITE_SUPER_ADMIN_EMAIL
# (build-time); the backend Deno functions read SUPER_ADMIN_EMAIL. Keep the two
# in sync. When UNSET there is no hard-coded owner email — super-admin is then
# determined solely by account_type (the one-time bootstrap, ensureSuperAdmin,
# can still promote the owner). Set these to enable the email override.
VITE_SUPER_ADMIN_EMAIL=          # optional — frontend owner email (build-time)
SUPER_ADMIN_EMAIL=               # optional — backend owner email (Deno function secret)

# Build-time compatibility toggle
# Set to true only if legacy Base44 SDK imports are still used.
BASE44_LEGACY_SDK_IMPORTS=false

# ---------------------------------------------------------------------------
# Backend app identity & branding (Deno function secrets — never VITE_*)
# ---------------------------------------------------------------------------
BASE44_APP_ID=                  # optional — Base44 app id the BACKEND functions use (e.g. building the
                                #   signer capability link in generateSignerToken). The frontend uses
                                #   VITE_BASE44_APP_ID above; set this to the same app id for the backend.
APP_URL=                        # optional — public base URL of the app (e.g. https://app.example.com), used
                                #   to build links in outbound email (signer portal link, signup URL). Falls
                                #   back to a default base44 host when unset.
APP_LOGO_URL=                   # optional — absolute URL of a logo image embedded in generated PDFs
                                #   (patient handouts, bag-technique guides, certificate packets). Blank = no logo.

# ---------------------------------------------------------------------------
# Telnyx integration (backend Deno function secrets) — text / voice / video / fax
#
# Telnyx powers SMS, masked voice calling, telehealth video, and programmable fax.
#
# EASIEST PATH: leave these blank and set the Telnyx API key (plus the optional
# resource ids) in-app at Administration -> Super Admin (kdeyarmin@comcast.net).
# Those values are stored backend-only (IntegrationSecret, provider 'telnyx') and
# power all four channels — no dashboard env needed. Main office number, off-duty
# template, and messaging settings are configured at runtime in Admin -> Super
# Admin (stored on AgencySettings).
#
# These env vars are also supported and TAKE PRECEDENCE over the in-app values
# when set. They are NOT VITE_* vars and must never reach the browser.
# ---------------------------------------------------------------------------
TELNYX_API_KEY=                 # optional — Telnyx API key (starts with KEY). Overrides the in-app value.
TELNYX_PUBLIC_KEY=              # optional — Telnyx Ed25519 webhook PUBLIC key (base64), used to verify inbound
                                #   webhooks (telnyx-signature-ed25519). Required for inbound delivery/status
                                #   webhooks to be accepted (fail-closed). Portal -> Account -> Keys & Credentials.
TELNYX_MESSAGING_PROFILE_ID=    # optional — Messaging Profile id for outbound SMS/MMS routing + opt-out handling.
TELNYX_VOICE_CONNECTION_ID=     # optional — Call Control Application connection id for outbound/masked voice.
                                #   (TELNYX_CONNECTION_ID is also accepted as a legacy alias.)
TELNYX_FAX_CONNECTION_ID=       # optional — Programmable Fax (FAX Application) connection id for outbound fax.
TELNYX_FAX_NUMBER=              # optional — E.164 Telnyx fax number on the fax connection (required for outbound fax).
FUNCTIONS_BASE_URL=             # optional — base URL like https://<app>/functions used to auto-build the
                                #   Telnyx webhook URL (handleTelnyxStatusWebhook) on outbound sends/calls.

# ---------------------------------------------------------------------------
# Backend security hardening (Deno function secrets — never VITE_*)
# ---------------------------------------------------------------------------
FILE_URL_ALLOWED_HOSTS=         # optional — comma-separated host allowlist for server-side file
                                #   fetches (processPatientFileUpdate). Set to your storage host(s),
                                #   e.g. "storage.example.com,base44.app". Mitigates SSRF + DNS rebinding.
FILE_URL_STRICT=               # optional — set to "true" to make FILE_URL_ALLOWED_HOSTS MANDATORY:
                                #   with strict on and no allowlist set, ALL external file fetches are
                                #   rejected (fail-closed). Configure FILE_URL_ALLOWED_HOSTS first.
INTERNAL_FN_SECRET=            # optional — when set, locks issueCertificate (and similar internal-only
                                #   functions) to the training system/admin. Set at launch.
SIGNUP_WEBHOOK_SECRET=         # optional — when set, locks onUserSignup to the trusted platform trigger.
SIGNATURE_HMAC_SECRET=         # optional — HMAC secret that signs/verifies e-signature integrity tokens
                                #   (signatureIntegrity). Set a long random value at launch so signed-document
                                #   integrity is cryptographically bound; unset disables that binding.
SECURITY_ALERT_EMAIL=          # optional — extra address that also receives security alerts (e.g. suspicious
                                #   signup activity in onUserSignup), in addition to the super admin.

# ---------------------------------------------------------------------------
# AI / media integrations (backend Deno function secrets — never VITE_*)
#
# These power specific features. Each is fully implemented in code but the
# feature will return a clear "not configured" message (surfaced to the user as
# an admin notice) until the key is set. See docs/FUNCTION_AUDIT_2026-06-19.md.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=                # required for: audio/Whisper transcription (incl. the transcription
                               #   step of SOAP-note-from-audio), AI training-course generation,
                               #   training-attempt grading, corrective-action-plan generation,
                               #   in-service rebuild.
ANTHROPIC_API_KEY=             # required for: AI fax cover-page generation and the SOAP-note-from-audio
                               #   generation step (clinical reasoning runs on claude-opus-4-8).
HEYGEN_API_KEY=                # required for: AI training-video generation.
# Telehealth video tokens and outbound fax are powered by the Telnyx integration
# above (TELNYX_API_KEY + TELNYX_FAX_NUMBER / TELNYX_FAX_CONNECTION_ID).

# ---------------------------------------------------------------------------
# Feature tuning (backend Deno function secrets — never VITE_*)
# ---------------------------------------------------------------------------
RISK_ALERT_MIN_SCORE=          # optional — minimum predicted risk score (0–100) required before
                               #   predictiveRiskAnalysis creates a patient risk alert. Defaults to 50.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
FUNCTIONS_DEBUG=               # optional — set to 1 to enable verbose operational console.log output in
                               #   backend functions. Off by default to keep logs quiet and PHI-free.

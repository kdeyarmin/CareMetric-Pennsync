# Base44 frontend runtime configuration (required)
VITE_BASE44_APP_ID=your-app-id
VITE_BASE44_BACKEND_URL=https://your-base44-backend.example.com

# Optional frontend-only owner-email override (UI gating). The backend determines
# admin/super-admin standing solely from role/account_type; an email-matched owner
# who isn't yet promoted can reach the Super Admin page, where ensureSuperAdmin
# promotes their account. Leave unset to gate purely by account_type.
VITE_SUPER_ADMIN_EMAIL=

# Build-time compatibility toggle
# Set to true only if legacy Base44 SDK imports are still used.
BASE44_LEGACY_SDK_IMPORTS=false

# ---------------------------------------------------------------------------
# Backend secrets (Deno function secrets — never VITE_*)
#
# These are the ONLY backend env vars the app reads. Everything else that
# used to be env-configured now lives in-app (Telnyx credentials + numbers in
# Administration -> Super Admin, stored on IntegrationSecret / AgencySettings)
# or is hardcoded (logo, storage-host allowlist, store links).
# ---------------------------------------------------------------------------

# Security (set at launch — fails less-safe when unset)
SIGNATURE_HMAC_SECRET=         # HMAC secret that signs/verifies e-signature integrity
                               #   tokens (signatureIntegrity). Long random value; without
                               #   it the integrity MAC is unkeyed sha256 (tamper-evident
                               #   for corruption, not forgery-resistant).
INTERNAL_FN_SECRET=            # Shared secret for scheduled/internal functions (the cron
                               #   family: fax/SMS queues, reminders, outcome measures, …).
                               #   Platform triggers must POST with header
                               #   x-internal-secret: <INTERNAL_FN_SECRET>; unattended runs
                               #   FAIL CLOSED (500) while it is unset. See
                               #   docs/LEARNING_CENTER_SCHEDULED_JOBS.md.

# Optional overrides
APP_PUBLIC_URL=                # Public app origin used in emailed links (password resets,
                               #   signer invites, notifications). Optional: falls back to
                               #   APP_URL, then the hosted default origin.
CARE_PLAN_MONITOR_MIN_CONFIDENCE= # Confidence floor (0-100, default 60) below which the
                               #   care-plan monitor skips auto-creating review proposals.

# AI / media feature keys (each feature shows a clear "not configured" notice
# until its key is set; the rest of the app is unaffected)
OPENAI_API_KEY=                # Whisper/audio transcription (incl. the transcription step
                               #   of SOAP-note-from-audio), AI training-course generation,
                               #   training-attempt grading, corrective-action plans,
                               #   in-service rebuild.
ANTHROPIC_API_KEY=             # AI fax cover-page generation and the SOAP-note-from-audio
                               #   generation step (clinical reasoning).
HEYGEN_API_KEY=                # AI training-video generation.
